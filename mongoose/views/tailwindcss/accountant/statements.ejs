<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">

  <h1 class="text-2xl font-bold mb-1">Bank statements</h1>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
    Statements loaded into the system, with each line checked against KashFlow.
  </p>

  <%- include('partials/_portal-nav', { active: 'statements' }) %>

  <% if (accounts.length) { %>
    <form method="GET" action="/accountant/statements" class="flex gap-2 flex-wrap mb-4">
      <select name="accountId"
        class="text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:outline-none focus:ring-2 focus:ring-green-500">
        <option value="">All accounts</option>
        <% accounts.forEach(a => { %>
          <option value="<%= a.accountId %>" <%= selectedAccountId === a.accountId ? 'selected' : '' %>>
            <%= a.accountName %>
          </option>
        <% }) %>
      </select>
      <button type="submit"
        class="text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition">
        Filter
      </button>
    </form>
  <% } %>

  <% if (!imports.length) { %>
    <div class="border border-gray-200 dark:border-gray-700 rounded-2xl p-8 text-center">
      <i class="bi bi-file-earmark-text text-3xl text-gray-300 dark:text-gray-600" aria-hidden="true"></i>
      <h2 class="font-semibold mt-3 mb-2">No statements loaded yet</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        Until a statement is loaded, the reconciliation compares KashFlow against itself. That
        shows whether each entry has a document behind it, but it cannot show an entry that was
        never made &mdash; money that left the account with nothing recorded against it.
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-3">
        Statements are loaded by the Heron CS finance team, either by email or by upload.
      </p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Account</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Period</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Lines</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Balance check</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Source</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-900">
          <% imports.forEach(imp => { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
              <td class="px-4 py-3">
                <div class="font-medium text-gray-900 dark:text-white">
                  <%= imp.accountName || imp.accountId || 'Unattributed' %>
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-xs">
                  <%= imp.originalFileName || '' %>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-gray-700 dark:text-gray-300">
                <% if (imp.periodStart) { %>
                  <%= slimDateTime(imp.periodStart) %> &ndash; <%= slimDateTime(imp.periodEnd) %>
                <% } else { %>
                  <span class="text-gray-400 dark:text-gray-500">&mdash;</span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap text-gray-700 dark:text-gray-300">
                <%= (imp.lineCount || 0).toLocaleString('en-GB') %>
              </td>
              <td class="px-4 py-3">
                <% if (imp.balanceChainOk) { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700">
                    <i class="bi bi-check-circle-fill"></i> reconciles
                  </span>
                <% } else { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700">
                    <i class="bi bi-exclamation-triangle-fill"></i> not trusted
                  </span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500 dark:text-gray-400">
                <%= imp.paperlessId ? 'Emailed' : 'Uploaded' %>
                <% if (imp.parserProfile) { %>
                  <div class="font-mono"><%= imp.parserProfile %></div>
                <% } %>
              </td>
              <td class="px-4 py-3 text-right">
                <a href="/accountant/statements/<%= imp.uuid %>"
                   class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700
                          bg-white dark:bg-gray-900 hover:bg-green-600 hover:text-white transition">
                  Open
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>
