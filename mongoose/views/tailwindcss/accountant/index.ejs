<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">

  <h1 class="text-2xl font-bold mb-1">Bank reconciliation</h1>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
    Heron CS bank accounts as recorded in KashFlow, with the supporting document for each line.
  </p>

  <%- include('partials/_portal-nav', { active: 'overview' }) %>

  <!--
    Statements lead. The house method is to reconcile from a printed statement,
    writing the KashFlow number beside each line; leading with KashFlow's own
    ledger would put the screen in the opposite order from the work.
  -->
  <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-5 mb-6">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">
          Statements
        </h2>
        <% if (!imports.length) { %>
          <p class="text-sm text-gray-700 dark:text-gray-300 max-w-2xl">
            No bank statements have been loaded yet, so every figure on this page is KashFlow
            checked against itself. That cannot show money which moved but was never entered &mdash;
            for that, a statement has to be loaded.
          </p>
        <% } else { %>
          <p class="text-sm text-gray-700 dark:text-gray-300 max-w-2xl">
            <%= trustedImports %> of <%= imports.length %> recent statement<%= imports.length === 1 ? '' : 's' %>
            reconciled against their own printed running balance and can be relied on.
            Only those are used to find missing entries.
          </p>
        <% } %>
      </div>
      <a href="/accountant/statements"
         class="text-sm px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700
                bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300
                hover:bg-gray-50 dark:hover:bg-gray-800 transition shadow-sm font-medium whitespace-nowrap">
        View statements
      </a>
    </div>

    <% if (imports.length) { %>
      <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <% imports.slice(0, 6).forEach(imp => { %>
          <a href="/accountant/statements/<%= imp.uuid %>"
             class="block p-3 rounded-xl border border-gray-200 dark:border-gray-700
                    hover:bg-gray-50 dark:hover:bg-gray-800 transition">
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm font-medium truncate">
                <%= imp.accountName || imp.accountId || 'Unattributed' %>
              </span>
              <% if (imp.status === 'parsed' && imp.balanceChainOk) { %>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700">verified</span>
              <% } else if (imp.status === 'needs-review') { %>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700">needs review</span>
              <% } else { %>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700"><%= imp.status %></span>
              <% } %>
            </div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
              <% if (imp.periodStart) { %>
                <%= slimDateTime(imp.periodStart) %> &ndash; <%= slimDateTime(imp.periodEnd) %>
              <% } else { %>
                <%= imp.originalFileName || 'No period read' %>
              <% } %>
              &middot; <%= imp.lineCount || 0 %> lines
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Position -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4">
      <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Bank lines</div>
      <div class="text-2xl font-bold mt-1"><%= (totals.transactions || 0).toLocaleString('en-GB') %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">across all accounts</div>
    </div>
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4">
      <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Agreed</div>
      <div class="text-2xl font-bold mt-1 text-green-700 dark:text-green-400">
        <%= (totals.confirmed || 0).toLocaleString('en-GB') %>
      </div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
        <%= totals.progress || 0 %>% &middot; checked and signed by a reviewer
      </div>
    </div>
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4">
      <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Proposed</div>
      <div class="text-2xl font-bold mt-1 text-blue-700 dark:text-blue-400">
        <%= (totals.suggested || 0).toLocaleString('en-GB') %>
      </div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">document identified, awaiting review</div>
    </div>
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4">
      <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Queries</div>
      <div class="text-2xl font-bold mt-1 <%= (totals.drifted || 0) > 0 ? 'text-amber-700 dark:text-amber-400' : '' %>">
        <%= (totals.drifted || 0).toLocaleString('en-GB') %>
      </div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
        <a href="/accountant/queries" class="text-green-700 dark:text-green-400 hover:underline">see queries</a>
      </div>
    </div>
  </div>

  <!-- Accounts -->
  <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Accounts</h2>

  <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
      <thead class="bg-gray-50 dark:bg-gray-800">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Account</th>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Lines</th>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Agreed</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Progress</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Covers</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-900">
        <% accounts.forEach(a => { %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
            <td class="px-4 py-3">
              <div class="font-medium text-gray-900 dark:text-white"><%= a.accountName %></div>
              <div class="text-xs text-gray-500 dark:text-gray-400">
                <%= a.accountId %>
                <% if (!a.known) { %>
                  &middot; <span class="text-amber-700 dark:text-amber-400">no longer in KashFlow</span>
                <% } %>
                <% if (a.isArchived) { %> &middot; archived<% } %>
              </div>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap text-gray-700 dark:text-gray-300">
              <%= (a.transactionCount || 0).toLocaleString('en-GB') %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap text-gray-700 dark:text-gray-300">
              <%= (a.confirmedCount || 0).toLocaleString('en-GB') %>
            </td>
            <td class="px-4 py-3 w-48">
              <div class="h-2 rounded-full bg-gray-100 dark:bg-gray-800 overflow-hidden">
                <div class="h-2 rounded-full bg-green-600" style="width: <%= a.progress || 0 %>%"></div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= a.progress || 0 %>%</div>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
              <% if (a.oldest) { %>
                <%= slimDateTime(a.oldest) %> &ndash; <%= slimDateTime(a.newest) %>
              <% } else { %>&mdash;<% } %>
            </td>
            <td class="px-4 py-3 text-right">
              <a href="/accountant/accounts/<%= a.accountId %>"
                 class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700
                        bg-white dark:bg-gray-900 hover:bg-green-600 hover:text-white transition">
                Open ledger
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (signOffs.length) { %>
    <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-8 mb-3">
      Recently signed periods
    </h2>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% signOffs.forEach(s => { %>
        <div class="p-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900">
          <div class="text-sm font-medium"><%= s.accountName || s.accountId %></div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
            <%= slimDateTime(s.periodStart) %> &ndash; <%= slimDateTime(s.periodEnd) %>
          </div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
            <%= s.status %> &middot; <%= s.signedByName || 'Unknown' %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>
