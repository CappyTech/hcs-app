<%
  const fmt = (s) => s ? new Date(`${s}T12:00:00Z`).toLocaleDateString('en-GB') : '';
  const inputCls = 'text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent';
%>
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%- include('../partials/breadcrumbs', { crumbs: [{ label: 'Home', href: '/' }, { label: 'Attendance', href: '/attendance' }], current: 'By person' }) %>

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
      <i class="bi bi-person-lines-fill text-green-600 dark:text-green-400" aria-hidden="true"></i> Attendance by person
    </h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Everyone with attendance from <%= fmt(range.from) %> to <%= fmt(range.to) %>. Open a person for their days, week by week.
    </p>
  </div>

  <%- include('_personRange', { range, action: '/attendance/person', inputCls }) %>

  <% if (!people.length) { %>
    <div class="text-sm text-gray-400 dark:text-gray-500 p-6 rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 text-center">
      No attendance in this period.
    </div>
  <% } else { %>
    <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Person</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Type</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Days</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Approved</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Waiting</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Latest day</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-900">
          <% people.forEach((p) => { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
              <td class="px-4 py-3">
                <a href="/attendance/person/<%= p.kind %>/<%= encodeURIComponent(p.uuid) %><%= rangeQuery %>" class="font-medium text-green-700 dark:text-green-400 hover:underline"><%= p.name || p.label %></a>
              </td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= p.label %></td>
              <td class="px-4 py-3 text-right tabular-nums text-gray-900 dark:text-white"><%= p.days %></td>
              <td class="px-4 py-3 text-right tabular-nums text-gray-900 dark:text-white"><%= p.approved %></td>
              <td class="px-4 py-3 text-right tabular-nums <%= p.waiting ? 'text-amber-700 dark:text-amber-400 font-medium' : 'text-gray-400' %>"><%= p.waiting %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= fmt(p.last) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
