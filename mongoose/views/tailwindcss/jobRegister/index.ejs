<%#
  Job Register: the plan of what will be in KashFlow (double entry), one row
  per job (its quotes and invoices with it), each number checked against the
  synced KashFlow quote, project and invoice. Each row opens the job's page.
  Locals: rows ({ entry, stage, match, values }), counts, clients, years, totals { quoted, won, invoiced },
          costs (optional: { byUuid: { uuid: { materials, labour, employeeLabour, boughtLabour, costs, margin, basis } | null }, totals, byYear }),
          filters, unregistered, next, unlinkedCount,
          stageLabels, stages, contracts, crumbs
%>
<%
  const card = 'bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm';
  const h2 = 'font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400';
  const input = 'text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500';
  const primaryBtn = 'text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition';
  const secondaryBtn = 'inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 text-sm font-medium transition shadow-sm';
  const th = 'px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 whitespace-nowrap';
  const td = 'px-3 py-2 text-gray-900 dark:text-gray-100 align-top';
  const label = 'block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1';
  const fmt = (d) => d ? new Date(d).toLocaleDateString('en-GB') : '';
  const money = (v) => v == null ? '' : '£' + Number(v).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const stagePill = {
    toQuote: 'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700',
    quoted: 'bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700',
    won: 'bg-blue-100 text-blue-800 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-700',
    completed: 'bg-teal-100 text-teal-800 border-teal-200 dark:bg-teal-900/40 dark:text-teal-300 dark:border-teal-700',
    invoiced: 'bg-green-100 text-green-800 border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700',
    cancelled: 'bg-red-100 text-red-800 border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-700',
  };
  const qs = (over) => {
    const p = { stage: filters.stage, client: filters.client, year: filters.year ?? '', q: filters.q, ...over };
    const parts = Object.entries(p).filter(([k, v]) => v !== '' && v != null && !(k === 'stage' && v === 'all'))
      .map(([k, v]) => `${k}=${encodeURIComponent(v)}`);
    return '/job-register' + (parts.length ? '?' + parts.join('&') : '');
  };
  const chips = [
    ['all', 'All'], ...stages.map((s) => [s, stageLabels[s]]),
    ['unmatched', 'Not in KashFlow yet'], ['differs', "Doesn't match KashFlow"],
  ];
  // One KashFlow check: tick, converted, missing, deleted or differs, e.g. "Quote 51234" (numbers only, so no escaping needed)
  const sideBadge = (s, what) => {
    if (s.state === 'none') return '';
    const name = s.number != null ? `${what} ${Number(s.number)}` : what;
    if (s.state === 'ok') return `<span class="inline-flex items-center gap-1 text-green-700 dark:text-green-400" title="${name} is in KashFlow and agrees"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>${name}</span>`;
    if (s.state === 'converted') return `<span class="inline-flex items-center gap-1 text-green-700 dark:text-green-400" title="Converted to invoice ${Number(s.invoice.number)} in KashFlow"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>${name} → Invoice ${Number(s.invoice.number)}</span>`;
    if (s.state === 'missing' && s.deleted) return `<span class="inline-flex items-center gap-1 text-amber-700 dark:text-amber-400" title="${name} was deleted in KashFlow, and no invoice it could have become was found"><i class="bi bi-trash" aria-hidden="true"></i>${name} deleted</span>`;
    if (s.state === 'missing' && what === 'Quote') return `<span class="inline-flex items-center gap-1 text-amber-700 dark:text-amber-400" title="${name}: not in KashFlow (not entered yet, deleted, or converted before it was synced)"><i class="bi bi-hourglass-split" aria-hidden="true"></i>${name}</span>`;
    if (s.state === 'missing') return `<span class="inline-flex items-center gap-1 text-amber-700 dark:text-amber-400" title="${name} isn't in KashFlow yet"><i class="bi bi-hourglass-split" aria-hidden="true"></i>${name}</span>`;
    return `<span class="inline-flex items-center gap-1 text-red-700 dark:text-red-400" title="${s.issues.join('; ').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;')}"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>${name}</span>`;
  };
  const yearLabel = (y) => `${y}/${String(y + 1).slice(-2)}`;
  const costs = locals.costs || null;
  const signed = (v) => (Number(v) < 0 ? '-' : '') + money(Math.abs(Number(v) || 0));
  const costOf = (e) => (costs ? costs.byUuid[e.uuid] ?? null : null);
  const marginClass = (v) => (v < 0 ? 'text-red-700 dark:text-red-400' : 'text-gray-900 dark:text-gray-100');
%>
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%- include('../partials/breadcrumbs', { crumbs, current: 'Job Register' }) %>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <i class="bi bi-journal-text text-green-600 dark:text-green-400" aria-hidden="true"></i>
        Job Register
      </h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Jobs and their quotes and invoices, entered here first and checked against KashFlow. A job is won when it has a project number; open one to add a variation or a stage payment.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/job-register/import" class="<%= secondaryBtn %> whitespace-nowrap"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i> Import workbook</a>
      <% } %>
      <a href="#add" class="<%= primaryBtn %> whitespace-nowrap"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add a job</a>
    </div>
  </div>

  <!-- Stage filter -->
  <div class="flex flex-wrap gap-2 mb-4" role="navigation" aria-label="Filter by stage">
    <% chips.forEach(([key, text]) => { const active = filters.stage === key; %>
      <a href="<%= qs({ stage: key }) %>"
         class="text-sm px-3 py-1.5 rounded-full border transition <%= active ? 'bg-green-600 border-green-600 text-white' : 'bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800' %>"
         <%= active ? 'aria-current=true' : '' %>>
        <%= text %> <span class="<%= active ? 'text-green-100' : 'text-gray-400' %>"><%= counts[key] ?? 0 %></span>
      </a>
    <% }) %>
  </div>

  <!-- Client, year, search -->
  <form method="GET" action="/job-register" class="<%= card %> p-4 mb-6 flex flex-wrap gap-3 items-end">
    <% if (filters.stage !== 'all') { %><input type="hidden" name="stage" value="<%= filters.stage %>"><% } %>
    <div>
      <label for="f-client" class="<%= label %>">Client</label>
      <select id="f-client" name="client" class="<%= input %>">
        <option value="">All clients</option>
        <% clients.forEach((c) => { %>
          <option value="<%= c.key %>" <%= filters.client && filters.client.trim().toLowerCase() === c.key ? 'selected' : '' %>><%= c.name %><%= c.variants > 1 ? ` (${c.variants} spellings)` : '' %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="f-year" class="<%= label %>">Tax year</label>
      <select id="f-year" name="year" class="<%= input %>">
        <option value="">All years</option>
        <% years.forEach((y) => { %>
          <option value="<%= y %>" <%= filters.year === y ? 'selected' : '' %>><%= yearLabel(y) %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex-1 min-w-48">
      <label for="f-q" class="<%= label %>">Search</label>
      <input id="f-q" name="q" value="<%= filters.q %>" placeholder="Site, contact, number, client ref…" class="<%= input %> w-full">
    </div>
    <button type="submit" class="<%= primaryBtn %>">Filter</button>
    <% if (filters.client || filters.year || filters.q) { %>
      <a href="<%= qs({ client: '', year: '', q: '' }) %>" class="<%= secondaryBtn %>">Clear</a>
    <% } %>
  </form>

  <!-- Totals -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="<%= card %> p-4">
      <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Quoted</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= money(totals.quoted) || '£0.00' %></p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Net, quotes not lost, excluding cancelled jobs</p>
    </div>
    <div class="<%= card %> p-4">
      <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Won</p>
      <p class="text-2xl font-bold text-blue-700 dark:text-blue-400"><%= money(totals.won) || '£0.00' %></p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Won jobs' agreed value, invoiced or not</p>
    </div>
    <div class="<%= card %> p-4">
      <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Invoiced</p>
      <p class="text-2xl font-bold text-green-700 dark:text-green-400"><%= money(totals.invoiced) || '£0.00' %></p>
    </div>
  </div>
  <% if (costs) { const ct = costs.totals; %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="<%= card %> p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Materials</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= money(ct.materials) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Purchase lines that aren't labour, excluding cancelled jobs</p>
      </div>
      <div class="<%= card %> p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Labour</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= money(ct.labour) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Employees' approved days at payroll rates + subcontractor labour invoiced</p>
      </div>
      <div class="<%= card %> p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Costs</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= money(ct.costs) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Materials + labour</p>
      </div>
      <div class="<%= card %> p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Margin</p>
        <p class="text-2xl font-bold <%= ct.margin < 0 ? 'text-red-700 dark:text-red-400' : 'text-green-700 dark:text-green-400' %>"><%= signed(ct.margin) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Invoiced (or agreed value while nothing is invoiced) − costs, jobs with a project number</p>
      </div>
    </div>
  <% } %>

  <!-- Clients not linked to KashFlow customers yet -->
  <% if (typeof unlinkedCount !== 'undefined' && unlinkedCount) { %>
    <div class="rounded-2xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 p-4 mb-6 text-sm text-gray-700 dark:text-gray-300 flex flex-wrap items-center justify-between gap-3">
      <span><i class="bi bi-exclamation-triangle-fill text-amber-600" aria-hidden="true"></i>
        <%= unlinkedCount %> job<%= unlinkedCount === 1 ? ' has a client' : 's have clients' %> typed in rather than chosen from the KashFlow customers.</span>
      <a href="/job-register/link-clients" class="<%= secondaryBtn %> whitespace-nowrap"><i class="bi bi-link-45deg" aria-hidden="true"></i> Link clients</a>
    </div>
  <% } %>

  <!-- The register, one table per tax year (newest first) -->
  <%
    const groupsByYear = new Map();
    rows.forEach((r) => { const k = r.taxYear ?? 'none'; (groupsByYear.get(k) || groupsByYear.set(k, []).get(k)).push(r); });
    const yearGroups = [...groupsByYear.entries()]
      .sort((a, b) => (a[0] === 'none') - (b[0] === 'none') || b[0] - a[0])
      .map(([year, list]) => {
        const live = list.filter((r) => r.stage !== 'cancelled');
        const sum = (xs, k) => xs.reduce((t, r) => t + (Number(r.values[k]) || 0), 0);
        return {
          year, rows: list,
          label: year === 'none' ? 'No date' : `Tax year ${yearLabel(year)}`,
          quoted: sum(live, 'quoted'), won: sum(live.filter((r) => ['won', 'completed', 'invoiced'].includes(r.stage)), 'agreed'), invoiced: sum(live, 'invoiced'),
        };
      });
  %>
  <% if (!rows.length) { %>
    <div class="text-sm text-gray-400 dark:text-gray-500 p-6 rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 text-center mb-6">
      Nothing in the register matches these filters.
    </div>
  <% } else { %>
    <% if (yearGroups.length > 1) { %>
      <nav class="flex flex-wrap gap-2 mb-4 text-sm" aria-label="Jump to a tax year">
        <% yearGroups.forEach((g) => { %><a href="#ty-<%= g.year %>" class="<%= secondaryBtn %>"><%= g.year === 'none' ? 'No date' : yearLabel(g.year) %> <span class="text-gray-400"><%= g.rows.length %></span></a><% }) %>
      </nav>
    <% } %>
    <% yearGroups.forEach((g) => { %>
      <section id="ty-<%= g.year %>" class="mb-8 scroll-mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-2">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= g.label %> <span class="text-sm font-normal text-gray-500 dark:text-gray-400">· <%= g.rows.length %> job<%= g.rows.length === 1 ? '' : 's' %></span></h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            <%= money(g.quoted) || '£0.00' %> quoted ·
            <span class="text-blue-700 dark:text-blue-400"><%= money(g.won) || '£0.00' %> won</span> ·
            <span class="text-green-700 dark:text-green-400"><%= money(g.invoiced) || '£0.00' %> invoiced</span>
            <% const yc = costs ? costs.byYear[g.year] : null; if (yc) { %>
              · <%= money(yc.materials) %> materials + <%= money(yc.labour) %> labour = <%= money(yc.costs) %> costs ·
              <span class="<%= marginClass(yc.margin) %>"><%= signed(yc.margin) %> margin</span>
            <% } %>
          </p>
        </div>
        <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th class="<%= th %>">Job</th>
            <th class="<%= th %>">Quotes</th>
            <th class="<%= th %>">Site / Client</th>
            <th class="<%= th %>">Stage</th>
            <th class="<%= th %> text-right">Quoted</th>
            <th class="<%= th %> text-right">Invoiced</th>
            <% if (costs) { %>
            <th class="<%= th %> text-right">Materials</th>
            <th class="<%= th %> text-right">Labour</th>
            <th class="<%= th %> text-right">Costs</th>
            <th class="<%= th %> text-right">Margin</th>
            <% } %>
            <th class="<%= th %>">KashFlow</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-900">
          <% g.rows.forEach(({ entry: e, stage, match, values }) => { const href = `/job-register/${e.uuid}`; const quotes = e.quotes || []; const invoices = e.invoices || []; %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition <%= stage === 'cancelled' ? 'opacity-60' : '' %>">
              <td class="<%= td %> whitespace-nowrap">
                <a href="<%= href %>" class="font-mono text-xs text-green-700 dark:text-green-400 hover:underline"><%= e.projectNumber ?? 'Enquiry' %></a>
                <p class="text-xs text-gray-500 dark:text-gray-400"><%= fmt(e.jobDate || (quotes[0] && quotes[0].date)) %></p>
              </td>
              <td class="<%= td %> font-mono text-xs">
                <% if (!quotes.length) { %><span class="text-gray-400">—</span><% } %>
                <% quotes.forEach((q) => { %><div class="<%= q.status === 'lost' ? 'line-through text-gray-400' : '' %>"><%= q.number ?? '(no number)' %></div><% }) %>
              </td>
              <td class="<%= td %>">
                <a href="<%= href %>" class="hover:underline"><%= e.site %></a>
                <p class="text-xs text-gray-500 dark:text-gray-400"><%= [e.client, e.contact, e.description].filter(Boolean).join(' · ') %><%= e.clientRef ? ` · ref ${e.clientRef}` : '' %></p>
              </td>
              <td class="<%= td %>">
                <span class="text-[11px] px-2 py-0.5 rounded-full border whitespace-nowrap <%= stagePill[stage] %>"><%= stageLabels[stage] %></span>
                <% if (stage === 'won' && e.inKashflow) { %><p class="text-xs text-gray-500 dark:text-gray-400 mt-1 whitespace-nowrap">Entered in KashFlow</p><% } %>
                <% if (e.notes) { %><p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= e.notes %></p><% } %>
              </td>
              <td class="<%= td %> text-right whitespace-nowrap"><%= money(values.quoted) %></td>
              <td class="<%= td %> text-right whitespace-nowrap">
                <% if (invoices.length) { %>
                  <%= money(values.invoiced) %>
                  <% if (stage === 'won' && values.agreed > values.invoiced) { %><p class="text-xs text-gray-500 dark:text-gray-400">of <%= money(values.agreed) %></p><% } %>
                <% } %>
              </td>
              <% if (costs) { const c = costOf(e); %>
                <% if (!c) { %>
                  <td class="<%= td %> text-right text-gray-400">—</td><td class="<%= td %> text-right text-gray-400">—</td><td class="<%= td %> text-right text-gray-400">—</td><td class="<%= td %> text-right text-gray-400">—</td>
                <% } else { %>
                  <td class="<%= td %> text-right whitespace-nowrap"><%= money(c.materials) %></td>
                  <td class="<%= td %> text-right whitespace-nowrap">
                    <%= money(c.labour) %>
                    <% if (c.employeeLabour && c.boughtLabour) { %><p class="text-xs text-gray-500 dark:text-gray-400"><%= money(c.employeeLabour) %> staff · <%= money(c.boughtLabour) %> subs</p><% } %>
                    <% if (c.pendingDays) { %><p class="text-xs text-amber-700 dark:text-amber-400" title="Not approved yet, not counted">+<%= c.pendingDays %> day<%= c.pendingDays === 1 ? '' : 's' %> pending</p><% } %>
                  </td>
                  <td class="<%= td %> text-right whitespace-nowrap"><%= money(c.costs) %></td>
                  <td class="<%= td %> text-right whitespace-nowrap">
                    <span class="<%= marginClass(c.margin) %>"><%= signed(c.margin) %></span>
                    <% if (c.basis === 'agreed') { %><p class="text-xs text-gray-500 dark:text-gray-400">on agreed</p><% } %>
                  </td>
                <% } %>
              <% } %>
              <td class="<%= td %> text-xs whitespace-nowrap">
                <div class="flex flex-col gap-0.5">
                  <%- sideBadge(match.project, 'Project') %>
                  <% match.quotes.forEach((s) => { %><%- sideBadge(s, 'Quote') %><% }) %>
                  <% match.invoices.forEach((s) => { %><%- sideBadge(s, 'Invoice') %><% }) %>
                </div>
                <% [match.project, ...match.quotes, ...match.invoices].flatMap((s) => s.issues).forEach((issue) => { %>
                  <p class="text-red-700 dark:text-red-400 whitespace-normal mt-0.5"><%= issue %></p>
                <% }) %>
                <% if (match.extras) { [...match.extras.quotes.map((r) => [`Quote ${r.Number}`, '']), ...match.extras.invoices.map((r) => [`Invoice ${r.Number}`, r.fromQuote != null ? ` (quote ${r.fromQuote} became it)` : ''])].forEach(([name, from]) => { %>
                  <p class="text-red-700 dark:text-red-400 whitespace-normal mt-0.5"><%= name %> is on this job in KashFlow, not here<%= from %></p>
                <% }) } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
          </table>
        </div>
      </section>
    <% }) %>
    <p class="text-xs text-gray-500 dark:text-gray-400 mb-6 flex flex-wrap gap-4">
      <span><i class="bi bi-check-circle-fill text-green-600" aria-hidden="true"></i> In KashFlow and agrees</span>
      <span><i class="bi bi-check-circle-fill text-green-600" aria-hidden="true"></i> Quote → Invoice: converted to that invoice in KashFlow</span>
      <span><i class="bi bi-hourglass-split text-amber-600" aria-hidden="true"></i> Not in KashFlow yet (or not synced; a quote may have been deleted, or converted before it was synced)</span>
      <span><i class="bi bi-trash text-amber-600" aria-hidden="true"></i> Deleted in KashFlow, no invoice found for it</span>
      <span><i class="bi bi-exclamation-triangle-fill text-red-600" aria-hidden="true"></i> In KashFlow but differs</span>
    </p>
  <% } %>

  <!-- The other side of the double entry -->
  <% if (unregistered.quoteCount || unregistered.projectCount) { %>
    <div class="rounded-2xl border p-4 mb-6 border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20">
      <h2 class="<%= h2 %> mb-1">In KashFlow, not in the register (<%= yearLabel(unregistered.year) %>)</h2>
      <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">
        <%= unregistered.quoteCount %> quote<%= unregistered.quoteCount === 1 ? '' : 's' %> and
        <%= unregistered.projectCount %> project<%= unregistered.projectCount === 1 ? '' : 's' %> in KashFlow aren't in the register.
        Add them so the two agree.
      </p>
      <div class="grid md:grid-cols-2 gap-4 text-sm">
        <% [['Quotes', unregistered.quotes, (r) => [r.Number, fmt(r.Date), r.CustomerName, money(r.NetAmount)], unregistered.quoteCount, '/quote/read/'],
            ['Projects', unregistered.projects, (r) => [r.Number, fmt(r.StartDate), r.Name, r.CustomerName], unregistered.projectCount, '/project/read/']]
            .forEach(([heading, list, cells, total, href]) => { if (!list.length) return; %>
          <div>
            <h3 class="font-medium text-gray-900 dark:text-gray-100 mb-1"><%= heading %></h3>
            <ul class="divide-y divide-amber-200 dark:divide-amber-800">
              <% list.forEach((r) => { const c = cells(r); %>
                <li class="py-1 flex gap-3">
                  <a href="<%= href %><%= r.uuid %>" class="font-mono text-xs text-green-700 dark:text-green-400 hover:underline"><%= c[0] %></a>
                  <span class="text-gray-500 dark:text-gray-400"><%= c[1] %></span>
                  <span class="flex-1 min-w-0 truncate text-gray-700 dark:text-gray-300"><%= c[2] %></span>
                  <span class="text-gray-500 dark:text-gray-400"><%= c[3] || '' %></span>
                </li>
              <% }) %>
            </ul>
            <% if (total > list.length) { %><p class="text-xs text-gray-500 dark:text-gray-400 mt-1">and <%= total - list.length %> more</p><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- Add -->
  <div id="add" class="<%= card %> p-4 scroll-mt-24">
    <h2 class="<%= h2 %> mb-1">Add a job</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      An enquiry is a job with a quote number and no project number yet; a job that's won has its project number. Give each the number it will have in KashFlow.
      <% if (next.quote) { %>Next quote number: <span class="font-mono"><%= next.quote %></span>.<% } %>
      <% if (next.project) { %>Next project number: <span class="font-mono"><%= next.project %></span>.<% } %>
      <% if ((next.quote || next.project) && (next.quoteSource === 'sync' || next.projectSource === 'sync')) { %><span class="text-amber-700 dark:text-amber-400">KashFlow didn't answer, so these are one past the last synced numbers; check them in KashFlow.</span><% } %>
      Leave the project number blank until the quote is won. More quotes and the invoices are added on the job's page.
    </p>
    <form method="POST" action="/job-register" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <%- include('../partials/csrfHidden') %>
      <%- include('_fields', { entry: locals.form || {}, next, clients, contracts, customers: locals.customers || [], input, label, nextAction: '/job-register/next#add', withQuote: true }) %>
      <div class="sm:col-span-2 lg:col-span-4">
        <button type="submit" class="<%= primaryBtn %>">Add to register</button>
      </div>
    </form>
  </div>
</div>
