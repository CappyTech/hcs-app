<%
  const _cssLine = (footerTitle || '')
    .replace(/&mdash;/g, '\u2014')
    .replace(/&bull;/g, '\u2022')
    .replace(/&amp;/g, '&')
    .replace(/\\/g, '\\\\')
    .replace(/"/g, '\\"');
  // _cssLine is already escaped above; the company values are escaped here
  const _cssEsc = (s) => String(s).replace(/\\/g, '\\\\').replace(/"/g, '\\"');
  const _cssFooter = [_cssLine, ...[locals.companyName, locals.companyAddress, locals.contactEmail].filter(Boolean).map(_cssEsc)]
    .filter(Boolean)
    .join(' \u2022 ');
%>
<style nonce="<%= locals.cspNonce %>">:root { --hcs-footer: "<%- _cssFooter %>"; }</style>
