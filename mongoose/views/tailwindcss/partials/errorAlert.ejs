<% if (flash.error && flash.error.length > 0) { %>
  <%# role="alert" so screen readers announce the error (WCAG 4.1.3). Errors stay until
      dismissed: an auto-dismiss would remove them before a slow reader finishes (2.2.1). %>
  <div class="fixed top-20 right-4 space-y-4 z-[60]">
    <% flash.error.forEach(function(message, index) { %>
   <div id="errorToast<%= index %>" role="alert" aria-atomic="true"
     class="relative flex items-start bg-red-600 dark:bg-red-700 text-white rounded-lg shadow-lg px-4 py-3 max-w-xs animate-slide-in">
        <div class="flex-1 pr-6">
          <p class="text-sm"><%= message %></p>
        </div>
        <button
          type="button"
          class="absolute top-2 right-2 rounded text-white hover:text-red-200 dark:hover:text-red-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          data-dismiss-target="errorToast<%= index %>"
          aria-label="Dismiss error">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>
    <% }); %>
  </div>

  <style nonce="<%= locals.cspNonce %>">
    @keyframes slide-in {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-slide-in {
      animation: slide-in 0.3s ease-out;
    }
  </style>

<% } %>
