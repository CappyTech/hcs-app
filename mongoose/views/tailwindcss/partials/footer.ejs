<footer class="w-full text-xs text-gray-600 dark:text-gray-400 py-2 border-t border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md shadow-sm">
  <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-x-4 gap-y-1 px-2 text-[0.75rem] leading-snug">
    <div>
      <span class="cursor-default" title="<%= (typeof lastfetched !== 'undefined' && lastfetched) ? slimDateTime(lastfetched.lastFetchedAt, ['includeTime']) : 'Never' %>">
        v<%= package %>
      </span>
      <% if (typeof commit !== 'undefined' && commit) { %>
        <span class="mx-1 text-gray-300 dark:text-gray-600" aria-hidden="true">&bull;</span>
        <a href="<%= commitUrl %>" target="_blank" rel="noopener noreferrer"
           class="inline-block py-1 text-green-600 dark:text-green-400 hover:underline font-mono" title="View commit <%= commit %> on GitHub">
          <%= commit %>
        </a>
      <% } %>
    </div>
    <div class="flex items-center space-x-2">
      <span>&copy; <%= copyrightyearstart %>–<%= copyrightyear %></span>
      <img src="<%= locals.brand ? brand.favicon : '/brand/icon-32.png' %>" alt="" class="w-4 h-4" />
      <% if (locals.websiteUrl) { %>
      <a href="<%= websiteUrl %>" class="inline-block py-1 text-green-600 dark:text-green-400 hover:underline whitespace-nowrap"><%= locals.companyName || websiteHost %></a>
      <% } else if (locals.companyName) { %>
      <span class="whitespace-nowrap"><%= companyName %></span>
      <% } %>
    </div>
    <% if (locals.companyVatNumber || locals.companyNumber) { %>
    <div>
      <span>
        <% if (locals.companyVatNumber) { %>VAT: <span class="whitespace-nowrap"><%= companyVatNumber %></span><% } %>
        <% if (locals.companyNumber) { %>Company: <a href="https://find-and-update.company-information.service.gov.uk/company/<%= encodeURIComponent(companyNumber) %>" class="inline-block py-1 text-green-600 dark:text-green-400 hover:underline" rel="noopener"><%= companyNumber %></a><% } %>
      </span>
    </div>
    <% } %>
    <div class="flex items-center space-x-2">
      <span>
        <a href="/legal/privacy-policy" class="inline-block py-1 hover:underline">Privacy</a>
        <span class="mx-1 text-gray-300 dark:text-gray-600" aria-hidden="true">&bull;</span>
        <a href="/legal/cookie-policy" class="inline-block py-1 hover:underline">Cookies</a>
        <span class="mx-1 text-gray-300 dark:text-gray-600" aria-hidden="true">&bull;</span>
        <a href="/legal/terms" class="inline-block py-1 hover:underline">Terms</a>
        <span class="mx-1 text-gray-300 dark:text-gray-600" aria-hidden="true">&bull;</span>
        <a href="/legal/accessibility" class="inline-block py-1 hover:underline">Accessibility</a>
      </span>
    </div>
  </div>
</footer>
