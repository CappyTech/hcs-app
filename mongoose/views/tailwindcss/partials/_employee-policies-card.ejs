<%
  // Policies card for the employee detail view: documents assigned to this
  // employee in Company Docs (contract, onboarding pack, handbook copy...).
  // Locals: item (employee), employeePolicies ({ policies[], canEdit, showStatus }).
  const _policies = Array.isArray(employeePolicies.policies) ? employeePolicies.policies : [];
  const _fmt = (d) => d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
%>
<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between gap-3">
    <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400"><i class="bi bi-file-earmark-text mr-1.5 text-blue-500"></i>Policies</h2>
    <% if (employeePolicies.canEdit) { %>
      <a href="/company-docs/policies/create?employee=<%= encodeURIComponent(item.uuid) %>"
         class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-900/50 transition">
        <i class="bi bi-plus-lg"></i> New document
      </a>
    <% } %>
  </div>
  <div class="p-6">
    <% if (_policies.length) { %>
      <ul class="space-y-2">
        <% _policies.forEach(p => { %>
          <li class="flex flex-wrap items-center gap-3 bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl px-4 py-3 text-sm text-gray-800 dark:text-gray-200">
            <i class="bi bi-file-earmark-text text-gray-400 shrink-0"></i>
            <div class="flex-1 min-w-0">
              <div class="truncate font-medium"><%= p.title %></div>
              <div class="text-xs text-gray-500 dark:text-gray-400"><%= p.category %> · v<%= p.version %></div>
            </div>
            <% if (employeePolicies.showStatus) { %>
              <% if (p.isPublished) { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300">
                  <i class="bi bi-check-circle-fill"></i> Published
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400">
                  <i class="bi bi-dash-circle"></i> Draft
                </span>
              <% } %>
              <% if (p.reviewState === 'expired' || p.reviewState === 'due') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium <%= p.reviewState === 'expired' ? 'bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300' : 'bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300' %>"
                      title="<%= p.reviewState === 'expired' ? 'Review was due' : 'Review due soon' %>">
                  <i class="bi <%= p.reviewState === 'expired' ? 'bi-exclamation-triangle-fill' : 'bi-clock-history' %>"></i>
                  Review <%= _fmt(p.reviewEffective) %>
                </span>
              <% } %>
            <% } %>
            <div class="flex items-center gap-2">
              <a href="/company-docs/policies/<%= p.uuid %>/print"
                 class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/50 transition">
                <i class="bi bi-eye"></i> View
              </a>
              <% if (employeePolicies.canEdit) { %>
                <a href="/company-docs/policies/<%= p.uuid %>/edit"
                   class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition">
                  <i class="bi bi-pencil"></i> Edit
                </a>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="text-sm text-gray-500 dark:text-gray-400 italic">No documents assigned to this employee yet.</p>
    <% } %>
  </div>
</div>
