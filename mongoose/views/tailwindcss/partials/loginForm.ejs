<%#
  The sign-in form, shared by the login page and the signed-out home page so
  there is one form to keep right. Posts to /user/login either way; a failed
  attempt lands on the login page with the error.

  Locals: next, turnstileEnabled, siteKey, skipTurnstile, msSsoEnabled
  (userCRUDController.renderLoginForm and indexController.renderIndex both
  pass turnstile.viewLocals() and microsoftSsoService.isEnabled()).
%>
<% const _next = typeof next !== 'undefined' && next ? next : ''; %>
<% const _input = 'w-full px-3.5 py-2 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 bg-gray-50 dark:bg-gray-800 text-sm text-gray-900 dark:text-gray-100'; %>
<% const _label = 'block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300'; %>
<% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>

<% if (typeof skipTurnstile !== 'undefined' && skipTurnstile) { %>
<div class="mb-4 p-3 rounded-xl bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 text-sm border border-amber-200 dark:border-amber-800">
  CAPTCHA bypass is active (SKIP_TURNSTILE=true). Do not enable this in production.
</div>
<% } %>

<form action="/user/login" method="POST" class="space-y-4">
  <div>
    <label for="usernameOrEmail" class="<%= _label %>">Username or email</label>
    <input type="text" id="usernameOrEmail" name="usernameOrEmail" required autofocus autocomplete="username" class="<%= _input %>">
  </div>

  <div>
    <label for="password" class="<%= _label %>">Password</label>
    <input type="password" id="password" name="password" required autocomplete="current-password" class="<%= _input %>">
  </div>

  <!-- Required only for accounts with two-factor sign-in turned on -->
  <div>
    <label for="totp" class="<%= _label %>">Two-factor code <span class="text-gray-400 dark:text-gray-500 font-normal">(if enabled)</span></label>
    <input type="text" id="totp" name="totp" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" placeholder="123456" class="<%= _input %>">
  </div>

  <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %>
  <div class="cf-turnstile" data-sitekey="<%= siteKey %>"></div>
  <% } %>

  <button type="submit" class="w-full inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-lg text-sm font-medium bg-green-600 text-white hover:bg-green-700 transition shadow-sm focus:ring-4 focus:ring-green-300 dark:focus:ring-green-800">
    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in
  </button>
  <%# Hidden fields last: as first children they'd count as siblings for space-y and push the first field down %>
  <%- include('./csrfHidden.ejs') %>
  <input type="hidden" name="next" value="<%= _next %>" />
</form>

<% if (typeof msSsoEnabled !== 'undefined' && msSsoEnabled) { %>
<div class="flex items-center gap-3 my-4">
  <span class="h-px flex-1 bg-gray-200 dark:bg-gray-700"></span>
  <span class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500">or</span>
  <span class="h-px flex-1 bg-gray-200 dark:bg-gray-700"></span>
</div>
<a href="/auth/microsoft<%= _next ? ('?next=' + encodeURIComponent(_next)) : '' %>"
   class="w-full inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg text-sm font-medium border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
  <i class="bi bi-microsoft" aria-hidden="true"></i> Sign in with Microsoft
</a>
<p class="text-center text-xs text-gray-400 dark:text-gray-500 mt-2">For existing accounts only.</p>
<% } %>

<div class="mt-4 flex items-center justify-center gap-2 text-sm">
  <a href="/user/forgot-password" class="text-green-700 dark:text-green-400 hover:underline">Forgot your password?</a>
  <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">·</span>
  <a href="/user/register" class="text-green-700 dark:text-green-400 hover:underline">Create an account</a>
</div>
