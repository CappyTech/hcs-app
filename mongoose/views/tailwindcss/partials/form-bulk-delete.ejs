<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <a href="<%= cancelUrl %>" class="inline-flex items-center gap-1 text-green-600 dark:text-green-400 hover:underline text-sm font-medium">
    <i class="bi bi-arrow-left"></i> Go Back
  </a>

  <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
    <!-- Red accent bar for delete -->
    <div class="h-1.5 bg-gradient-to-r from-red-500 to-red-400"></div>

    <div class="p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6"><%= title %></h1>

      <% if (skippedSelf) { %>
        <div id="bulk-delete-self-note" class="mb-4 border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 rounded-xl px-4 py-3 text-sm text-amber-700 dark:text-amber-400">
          <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Your own account was ticked. It has been left out and won't be deleted.
        </div>
      <% } %>
      <% if (missingCount > 0) { %>
        <div id="bulk-delete-missing-note" class="mb-4 border border-blue-300 dark:border-blue-700 bg-blue-50 dark:bg-blue-900/20 rounded-xl px-4 py-3 text-sm text-blue-800 dark:text-blue-300">
          <i class="bi bi-info-circle" aria-hidden="true"></i> <%= missingCount %> ticked record<%= missingCount === 1 ? ' no longer exists' : 's no longer exist' %> and <%= missingCount === 1 ? 'is' : 'are' %> left out.
        </div>
      <% } %>

      <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Records to delete</h2>
      <ul id="bulk-delete-records" class="divide-y divide-gray-100 dark:divide-gray-700 border border-gray-200 dark:border-gray-700 rounded-xl mb-6 max-h-96 overflow-y-auto">
        <% records.forEach((r) => { %>
          <li class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300"><%= r.label %></li>
        <% }) %>
      </ul>

      <!-- Confirmation panel -->
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-5">
        <p class="text-red-700 dark:text-red-300 mb-4 font-medium">
          This will permanently delete <strong><%= records.length %></strong> record<%= records.length === 1 ? '' : 's' %>. This action cannot be undone.
        </p>
        <form action="<%= formAction %>" method="POST" class="flex gap-3">
          <%- include('./csrfHidden.ejs') %>
          <input type="hidden" name="count" value="<%= records.length %>">
          <% records.forEach((r) => { %>
            <input type="hidden" name="uuids" value="<%= r.uuid %>">
          <% }) %>
          <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg text-sm font-medium bg-red-600 text-white hover:bg-red-700 transition shadow-sm">
            <i class="bi bi-trash"></i> Delete <%= records.length %> record<%= records.length === 1 ? '' : 's' %>
          </button>
          <a href="<%= cancelUrl %>" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition shadow-sm">
            Cancel
          </a>
        </form>
      </div>
    </div>
  </div>
</div>
