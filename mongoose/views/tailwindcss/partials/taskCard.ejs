<div class="flex flex-col flex-grow bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
  <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
  <div class="px-5 py-3 font-bold text-gray-900 dark:text-gray-100">
    <%= title %>
  </div>
  <ul class="divide-y divide-gray-200 dark:divide-gray-700">
    <% if (tasks.length) { %>
      <% tasks.forEach(t => { %>
        <li class="px-4 py-3 flex items-start gap-3">
          <div class="min-w-0 flex-grow">
            <div class="flex items-center gap-2 flex-wrap">
              <%# The task detail page is admin-only; everyone else just sees the title. %>
              <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a href="/task/read/<%= t.uuid %>" class="font-semibold text-green-700 dark:text-green-400 hover:underline">
                  <%= t.title %>
                </a>
              <% } else { %>
                <span class="font-semibold text-gray-900 dark:text-gray-100"><%= t.title %></span>
              <% } %>
              <% if (t.priority === 'high') { %>
                <span class="inline-flex items-center rounded-full bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide">High</span>
              <% } else if (t.priority === 'low') { %>
                <span class="inline-flex items-center rounded-full bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide">Low</span>
              <% } %>
              <% if (t.source === 'system') { %>
                <span title="Automatically generated" class="inline-flex items-center gap-1 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide"><i class="bi bi-gear-fill text-[10px]"></i> System</span>
              <% } %>
              <% if (showRecurrence && t.recurrence && t.recurrence !== 'none') { %><span title="Recurring">🔁</span><% } %>
            </div>
            <% if (t.dueDate) { %>
              <% const _overdue = new Date(t.dueDate) < new Date(); %>
              <% if (_overdue) { %>
                <div class="text-red-600 dark:text-red-400 text-sm font-medium mt-1">Overdue &middot; <%= slimDateTime(t.dueDate) %></div>
              <% } else { %>
                <div class="text-gray-500 dark:text-gray-400 text-sm mt-1">Due <%= slimDateTime(t.dueDate) %></div>
              <% } %>
            <% } %>
            <% if (t.description) { %>
              <div class="mt-1 text-gray-700 dark:text-gray-300 text-sm"><%= t.description %></div>
            <% } %>
          </div>
          <%# A labelled button rather than a bare tick: it reads as an action and is harder to hit by accident. %>
          <form action="/task/<%= t.uuid %>/complete" method="POST" class="shrink-0 self-center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" title="Mark this task as done"
                    class="inline-flex items-center gap-1 text-xs px-3 py-1.5 rounded-lg border border-green-600 text-green-700 dark:text-green-400 dark:border-green-500 bg-white dark:bg-gray-900 hover:bg-green-600 hover:text-white dark:hover:bg-green-600 dark:hover:text-white shadow-sm font-medium transition">
              <i class="bi bi-check2"></i> Mark done
            </button>
          </form>
        </li>
      <% }) %>
    <% } else { %>
      <li class="px-4 py-3 italic text-gray-500 dark:text-gray-400">
        <%= emptyMsg %>
      </li>
    <% } %>
  </ul>
</div>
