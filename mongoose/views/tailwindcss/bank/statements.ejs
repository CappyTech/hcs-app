<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">

  <div class="flex items-center gap-3 mb-6">
    <a href="/bank" class="text-sm text-green-700 dark:text-green-400 hover:underline">&larr; Bank</a>
    <span class="text-gray-400">/</span>
    <h1 class="text-xl font-bold">Bank statements</h1>
  </div>

  <div class="border border-blue-300 dark:border-blue-700 bg-blue-50 dark:bg-blue-900/20 rounded-2xl p-4 mb-6">
    <p class="text-sm text-gray-700 dark:text-gray-300">
      A statement is the only independent record of what actually left and entered the account.
      Reconciling KashFlow against itself can never reveal a payment that was never booked;
      a statement can.
    </p>
  </div>

  <!-- Fetch from Paperless -->
  <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4 mb-6">
    <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">
      From Paperless
    </h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">
      Statements emailed to <span class="font-mono text-xs">bank.statements@heroncs.co.uk</span>
      are filed in Paperless and tagged <span class="font-mono text-xs">bank-statement</span>.
      This reads them and writes the outcome back as a tag. It also runs on its own every six hours.
    </p>
    <form method="POST" action="/bank/statements/grab">
      <%- include('../partials/csrfHidden') %>
      <button type="submit"
        class="text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition">
        <i class="bi bi-arrow-repeat"></i> Fetch from Paperless
      </button>
    </form>
  </div>

  <!-- Upload -->
  <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4 mb-6">
    <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">
      Upload a statement
    </h2>

    <form method="POST" action="/bank/statements/upload" enctype="multipart/form-data"
          class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <%- include('../partials/csrfHidden') %>

      <div class="md:col-span-3">
        <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1" for="accountId">Account</label>
        <select id="accountId" name="accountId" required
          class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500">
          <option value="">&mdash; Choose &mdash;</option>
          <% accounts.forEach(a => { %>
            <option value="<%= a.accountId %>"><%= a.accountName %></option>
          <% }) %>
        </select>
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1" for="statement">
          CSV or OFX file
        </label>
        <input type="file" id="statement" name="statement" accept=".csv,.txt,.ofx,.qfx" required
          class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:outline-none focus:ring-2 focus:ring-green-500" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1" for="layout">CSV layout</label>
        <select id="layout" name="layout"
          class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500">
          <% Object.entries(layouts).forEach(([key, l]) => { %>
            <option value="<%= key %>"><%= l.label %></option>
          <% }) %>
        </select>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Ignored for OFX files.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1" for="openingBalance">
          Opening balance
        </label>
        <input type="number" step="0.01" id="openingBalance" name="openingBalance" placeholder="optional"
          class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1" for="closingBalance">
          Closing balance
        </label>
        <input type="number" step="0.01" id="closingBalance" name="closingBalance" placeholder="optional"
          class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500" />
      </div>

      <div class="md:col-span-3">
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
          Supplying the opening and closing balances adds a second check: they must agree with
          the movements in the file.
        </p>
        <button type="submit"
          class="text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition">
          <i class="bi bi-upload"></i> Upload and read
        </button>
      </div>
    </form>
  </div>

  <!-- History -->
  <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Imported statements</h2>

  <% if (!imports.length) { %>
    <div class="text-sm text-gray-400 dark:text-gray-500 p-6 rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 text-center">
      No statements have been imported yet.
    </div>
  <% } else { %>
    <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Statement</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Account</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Period</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Lines</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Balance check</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-900">
          <% imports.forEach(imp => { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
              <td class="px-4 py-3 text-gray-900 dark:text-white">
                <%= imp.originalFileName || imp.uuid %>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                  <%= imp.source %> &middot; <%= imp.parserProfile %>
                  <% if (imp.importedByName) { %>&middot; <%= imp.importedByName %><% } %>
                </div>
              </td>
              <td class="px-4 py-3 text-gray-700 dark:text-gray-300"><%= imp.accountName || imp.accountId %></td>
              <td class="px-4 py-3 text-gray-700 dark:text-gray-300 whitespace-nowrap text-xs">
                <% if (imp.periodStart) { %>
                  <%= slimDateTime(imp.periodStart) %> &ndash; <%= slimDateTime(imp.periodEnd) %>
                <% } else { %>&mdash;<% } %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= imp.lineCount %>
                <% if (imp.duplicateCount) { %>
                  <div class="text-xs text-gray-500 dark:text-gray-400"><%= imp.duplicateCount %> dup</div>
                <% } %>
              </td>
              <td class="px-4 py-3">
                <% if (imp.balanceChainOk) { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700">
                    <i class="bi bi-check-circle-fill"></i> reconciles
                  </span>
                <% } else if (imp.status === 'failed') { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-700">
                    unreadable
                  </span>
                <% } else { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700">
                    <i class="bi bi-exclamation-triangle-fill"></i> not trusted
                  </span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-right">
                <a href="/bank/statements/<%= imp.uuid %>"
                  class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:bg-green-600 hover:text-white transition">
                  Open
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
