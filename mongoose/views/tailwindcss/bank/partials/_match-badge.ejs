<%
/*
 * Status pill for a bankMatch. Expects `match` (may be null) and optionally
 * `strategy` for lines that have no match record yet.
 *
 * Classes are written out per branch rather than composed from a variable, so
 * the Tailwind scanner sees every one of them literally and no safelist entry
 * is needed.
 */
const status = match ? match.status : null;
const integrity = match ? match.integrity : 'ok';
%>
<% if (status === 'confirmed' && integrity !== 'ok') { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700">
    <i class="bi bi-exclamation-triangle-fill"></i> confirmed &middot; <%= integrity %>
  </span>
<% } else if (status === 'confirmed') { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700">
    <i class="bi bi-check-circle-fill"></i> confirmed
  </span>
<% } else if (status === 'suggested') { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-700">
    suggested
  </span>
<% } else if (status === 'rejected') { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-700">
    rejected
  </span>
<% } else if (status === 'superseded') { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700">
    superseded
  </span>
<% } else if (typeof strategy !== 'undefined' && strategy === 'unlinked') { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700">
    no KashFlow link
  </span>
<% } else { %>
  <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700">
    not reviewed
  </span>
<% } %>
