<% /* Signed in: one readable column. Signed out: two panes across the full width (sign-in left, features right). */ %>
<div class="<%= isAuthenticated ? 'max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6' : 'w-full' %>">

  <% if (isAuthenticated) { %>

    <!-- Welcome + Holiday -->
    <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
      <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Welcome, <%= firstName %>.</h1>
          <span class="inline-flex items-center gap-1 mt-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
            <i class="bi bi-person-check"></i> <%= role.charAt(0).toUpperCase() + role.slice(1) %>
          </span>
        </div>
        <% if (nextHoliday) { %>
        <div class="text-sm text-right text-gray-600 dark:text-gray-400">
          <div class="font-semibold text-gray-900 dark:text-gray-100">Next Bank Holiday</div>
          <div><%= nextHoliday.reason %></div>
          <div class="text-green-600 dark:text-green-400 font-medium">
            <% if (nextHoliday.startDate === nextHoliday.endDate) { %>
              <%= slimDateTime(nextHoliday.startDate, ['displayFormat']) %>
            <% } else { %>
              <%= slimDateTime(nextHoliday.startDate, ['displayFormat']) %> – <%= slimDateTime(nextHoliday.endDate, ['displayFormat']) %>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Overviews: this person's pinned figures, lists and area tiles (homeLayoutService) -->
    <% const _home = typeof home !== 'undefined' && home ? home : { tiles: [], figures: [], lists: [] }; %>
    <% if (_home.figures.length) { %>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-3">
      <% _home.figures.forEach((f) => { %>
        <%
          const _hot = f.value > 0 && (f.severity === 'critical' || f.severity === 'warning');
          const _card = !_hot ? 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900'
            : f.severity === 'critical' ? 'border-red-300 dark:border-red-700 bg-red-50 dark:bg-red-900/20' : 'border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20';
          const _val = f.value === null ? 'text-gray-400 dark:text-gray-500'
            : !_hot ? 'text-gray-900 dark:text-gray-100' : f.severity === 'critical' ? 'text-red-600 dark:text-red-400' : 'text-amber-600 dark:text-amber-400';
        %>
        <a href="<%= f.href %>" title="<%= f.hint || 'Show these in the list' %>" class="block border rounded-2xl shadow-sm p-4 hover:shadow-md hover:border-green-400 dark:hover:border-green-600 transition <%= _card %>">
          <p class="text-2xl font-bold tabular-nums <%= _val %>"><%= f.display || (f.value === null ? '—' : Number(f.value).toLocaleString('en-GB')) %></p>
          <p class="mt-1 text-xs font-medium text-gray-600 dark:text-gray-400 leading-snug"><%= f.label %></p>
          <% if (f.group) { %><p class="text-[11px] text-gray-400 dark:text-gray-500"><%= f.group %></p><% } %>
        </a>
      <% }) %>
    </div>
    <% } %>

    <% if (_home.lists.length) { %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <% _home.lists.forEach((l) => { %>
        <%- include('overview/partials/listCard', { l }) %>
      <% }) %>
    </div>
    <% } %>

    <% if (isAuthenticated) { %>
    <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
      <div class="border-b border-gray-200 dark:border-gray-700 px-6 py-3 font-semibold text-sm text-gray-900 dark:text-gray-100 flex items-center justify-between gap-2">
        <span class="flex items-center gap-2"><i class="bi bi-speedometer2 text-green-600 dark:text-green-400"></i> Overviews</span>
        <a href="/home/customise" class="text-xs font-medium text-green-700 dark:text-green-400 hover:underline inline-flex items-center gap-1"><i class="bi bi-sliders" aria-hidden="true"></i> Customise home</a>
      </div>
      <% if (_home.tiles.length) { %>
      <div class="p-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        <% for (const ov of _home.tiles) { %>
          <a href="<%= ov.href %>" class="flex flex-col gap-1 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 hover:bg-green-50 dark:hover:bg-green-900/20 hover:border-green-300 dark:hover:border-green-700 p-4 transition">
            <i class="bi <%= ov.icon %> text-2xl text-green-600 dark:text-green-400"></i>
            <span class="font-semibold text-sm text-gray-900 dark:text-gray-100"><%= ov.label %></span>
            <span class="text-xs text-gray-500 dark:text-gray-400"><%= ov.description %></span>
          </a>
        <% } %>
      </div>
      <% } else { %>
      <p class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">No overview tiles are pinned. <a href="/home/customise" class="text-green-700 dark:text-green-400 hover:underline">Choose some</a>.</p>
      <% } %>
    </div>
    <% } %>

    <!-- Frequently Visited -->
    <% if (frequentPages && frequentPages.length > 0) { %>
    <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
      <div class="border-b border-gray-200 dark:border-gray-700 px-6 py-3 font-semibold text-sm text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <i class="bi bi-clock-history text-green-600 dark:text-green-400"></i> Frequently Visited
      </div>
      <div class="px-4 py-3 flex flex-wrap gap-2">
        <% frequentPages.forEach(function(page) { %>
          <a href="<%= page.path %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-green-600 dark:hover:text-green-400 transition">
            <%= page.label %>
            <span class="text-[10px] text-gray-400 dark:text-gray-500 tabular-nums"><%= page.count %></span>
          </a>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Tasks -->
    <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
      <div class="border-b border-gray-200 dark:border-gray-700 px-6 py-3 flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex items-center gap-3 flex-grow">
          <span class="font-bold text-gray-900 dark:text-gray-100">Your Tasks</span>
          <% if (taskCounts.overdue > 0) { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400"><%= taskCounts.overdue %> overdue</span>
          <% } %>
          <% if (tasks.today.length > 0) { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400"><%= tasks.today.length %> today</span>
          <% } %>
          <% if (taskCounts.total > 0) { %>
            <span class="text-xs text-gray-400 dark:text-gray-500"><%= taskCounts.total %> open</span>
          <% } %>
        </div>
        <div class="flex items-center gap-2">
          <a href="/tasks" class="text-xs text-gray-500 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 hover:underline">View all</a>
          <a href="/task/create" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 transition"><i class="bi bi-plus-lg"></i> New Task</a>
        </div>
      </div>
      <!-- Quick Add -->
      <form action="/quick-task" method="POST" class="px-6 py-3 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row gap-2 items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="flex-grow">
          <label for="qt-title" class="sr-only">Task title</label>
          <input type="text" id="qt-title" name="title" required maxlength="200" placeholder="Quick add a task…"
                 class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-sm text-gray-900 dark:text-gray-100 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none">
        </div>
        <div class="w-full sm:w-40">
          <label for="qt-due" class="sr-only">Due date</label>
          <input type="date" id="qt-due" name="dueDate"
                 class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-sm text-gray-900 dark:text-gray-100 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none">
        </div>
        <button type="submit" class="inline-flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 transition whitespace-nowrap">
          <i class="bi bi-plus-lg"></i> Add
        </button>
      </form>
      <!-- Task columns — only render non-empty groups -->
      <% const taskGroups = [
        { title: 'Overdue',       list: tasks.overdue,   id: 'overdue'   },
        { title: 'Today',         list: tasks.today,     id: 'today'     },
        { title: 'This Week',     list: tasks.week,      id: 'week'      },
        { title: 'This Month',    list: tasks.month,     id: 'month'     },
        { title: 'General',       list: tasks.general,   id: 'general'   },
        { title: 'Recurring',     list: tasks.recurring, id: 'recurring' },
      ].filter(g => g.list.length > 0); %>
      <% if (taskGroups.length > 0) { %>
        <div class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% for (const g of taskGroups) { %>
            <%- include('partials/taskCard', { title: g.title, tasks: g.list, emptyMsg: '', showRecurrence: true }) %>
          <% } %>
        </div>
      <% } else { %>
        <p class="px-6 py-6 text-sm text-gray-500 dark:text-gray-400 italic">No open tasks. Add one above.</p>
      <% } %>
    </div>

  <% } else { %>

    <%
      const _features = typeof publicFeatures !== 'undefined' ? publicFeatures : [];
      // Groups flow into balanced columns (a group never splits), so the whole list fits
      // on one laptop screen: 2 columns on tablets, up to 4 from 1280px, up to 5 from 1536px.
      // Never more columns than groups, so hiding modules leaves no empty column.
      // Literal class names, so the Tailwind build finds them.
      const _n = _features.length;
      const _cols = [
        _n >= 2 ? 'sm:columns-2' : '',
        ['', 'xl:columns-1', 'xl:columns-2', 'xl:columns-3', 'xl:columns-4'][Math.min(_n, 4)],
        ['', '2xl:columns-1', '2xl:columns-2', '2xl:columns-3', '2xl:columns-4', '2xl:columns-5'][Math.min(_n, 5)],
      ].join(' ');
    %>
    <div class="grid gap-6 items-start <%= _features.length ? 'lg:grid-cols-[minmax(18rem,22rem)_1fr]' : 'max-w-xl mx-auto' %>">

      <!-- Left pane: who this is for, and sign in. Stays in view while the features scroll. -->
      <aside class="lg:sticky lg:top-6 bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
        <div class="p-6 sm:p-8">
          <h1 class="text-3xl font-bold leading-tight text-gray-900 dark:text-gray-100"><%= (locals.companyName ? companyName + ' ' : '') %>Management System</h1>
          <% if (locals.companyName) { %>
          <p class="text-base text-gray-500 dark:text-gray-400 mt-2">
            The internal platform of
            <% if (locals.websiteUrl) { %><a href="<%= websiteUrl %>" class="text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 font-medium"><%= companyName %></a><% } else { %><span class="font-medium"><%= companyName %></span><% } %>
          </p>
          <% } %>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-4">
            One internal platform for running the business, all in one place.<% if (_features.length) { %> <span class="lg:hidden">What it does is listed below.</span><span class="hidden lg:inline">What it does is listed alongside.</span><% } %>
          </p>
          <a href="/user/login" class="flex w-full items-center justify-center gap-1.5 mt-6 px-6 py-3 rounded-lg text-sm font-medium bg-green-600 text-white hover:bg-green-700 transition shadow-sm">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log In
          </a>
          <p class="mt-3 text-xs text-gray-500 dark:text-gray-400 text-center">New here? <a href="/user/register" class="text-green-700 dark:text-green-400 hover:underline">Create an account</a>. An administrator then gives you access.</p>
        </div>
      </aside>

      <% if (_features.length) { %>
      <!-- Right pane: everything this company uses (publicFeaturesConfig, filtered by publicFeaturesService) -->
      <section aria-labelledby="whats-inside" class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
        <div class="border-b border-gray-200 dark:border-gray-700 px-6 py-3 font-semibold text-sm text-gray-900 dark:text-gray-100 flex items-center gap-2">
          <i class="bi bi-grid text-green-600 dark:text-green-400" aria-hidden="true"></i> <span id="whats-inside">What's inside</span>
        </div>
        <div class="p-4 sm:p-5 gap-5 <%= _cols %>">
          <% _features.forEach((g) => { %>
          <div class="break-inside-avoid mb-5 last:mb-0">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2 flex items-center gap-1.5">
              <i class="bi <%= g.icon %>" aria-hidden="true"></i> <%= g.group %>
            </h2>
            <ul class="space-y-2">
              <% g.items.forEach((f) => { %>
              <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 px-3 py-2.5">
                <span class="flex items-center gap-2 font-semibold text-sm text-gray-900 dark:text-gray-100">
                  <span class="flex items-center justify-center w-6 h-6 rounded-md bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 shrink-0 text-xs">
                    <i class="bi <%= f.icon %>" aria-hidden="true"></i>
                  </span>
                  <%= f.title %>
                </span>
                <span class="block text-xs text-gray-600 dark:text-gray-400 mt-1 leading-snug"><%= f.text %></span>
              </li>
              <% }) %>
            </ul>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>

    </div>

  <% } %>
</div>
