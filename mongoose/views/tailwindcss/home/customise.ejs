<%#
  Choose what home shows (homeLayoutController). Used for a person's own home
  and for an admin's per-role starting layout. Forms only: tick to pin, number
  to order (lower first; blank keeps the order shown).
%>
<%
  const _num = 'w-16 text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-2 py-1 bg-white dark:bg-gray-800 text-gray-900 dark:text-white';
  const _row = 'flex items-center justify-between gap-3 px-3 py-2';
  const _check = 'inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 min-w-0';
%>
<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <div class="text-sm"><a href="<%= back.href %>" class="text-green-700 dark:text-green-400 hover:underline"><%= back.label %></a></div>
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= heading %></h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= intro %></p>
  </div>

  <% if (typeof roles !== 'undefined') { %>
    <nav class="flex flex-wrap gap-2" aria-label="Roles">
      <% roles.forEach((r) => { %>
        <a href="/admin/overviews/home/<%= r %>" class="px-3 py-1.5 rounded-lg text-sm border <%= r === role ? 'border-green-500 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 font-medium' : 'border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800' %>"><%= r %></a>
      <% }) %>
    </nav>
  <% } %>

  <form method="POST" action="<%= action %>" class="space-y-6">
    <%- include('../partials/csrfHidden') %>

    <section class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-800">
        <h2 class="font-semibold text-gray-900 dark:text-gray-100">Overview tiles</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400">The areas shown as tiles on home (up to <%= limits.areas %>).</p>
      </div>
      <div class="divide-y divide-gray-100 dark:divide-gray-800">
        <% groups.forEach((g) => { %>
          <div class="<%= _row %>">
            <label class="<%= _check %>">
              <input type="checkbox" name="pin" value="<%= g.area.key %>" <%= selected[g.area.key] ? 'checked' : '' %>>
              <i class="bi <%= g.area.icon %> text-gray-400" aria-hidden="true"></i> <%= g.area.label %>
            </label>
            <input type="number" name="order[<%= g.area.key %>]" value="<%= selected[g.area.key] || '' %>" min="0" max="999" aria-label="Position of <%= g.area.label %>" class="<%= _num %>">
          </div>
        <% }) %>
      </div>
    </section>

    <section class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-800">
        <h2 class="font-semibold text-gray-900 dark:text-gray-100">Figures and lists</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400">Figures appear as numbers at the top of home (up to <%= limits.figures %>); lists show their first few records (up to <%= limits.lists %>). Each links to the full list.</p>
      </div>
      <% const _withContent = groups.filter((g) => g.sections.length); %>
      <% if (!_withContent.length) { %>
        <p class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 italic">There are no figures you can pin.</p>
      <% } %>
      <% _withContent.forEach((g) => { %>
        <details class="border-b border-gray-100 dark:border-gray-800 last:border-b-0" <%= g.sections.some((s) => [...s.figures, ...s.lists].some((x) => selected[x.key])) ? 'open' : '' %>>
          <summary class="px-5 py-3 cursor-pointer text-sm font-semibold text-gray-800 dark:text-gray-200 flex items-center gap-2">
            <i class="bi <%= g.area.icon %> text-gray-400" aria-hidden="true"></i> <%= g.area.label %>
          </summary>
          <div class="px-5 pb-4 space-y-4">
            <% g.sections.forEach((s) => { %>
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1"><%= s.label %></h3>
                <div class="border border-gray-200 dark:border-gray-700 rounded-xl divide-y divide-gray-100 dark:divide-gray-800">
                  <% s.figures.forEach((f) => { %>
                    <div class="<%= _row %>">
                      <label class="<%= _check %>"><input type="checkbox" name="pin" value="<%= f.key %>" <%= selected[f.key] ? 'checked' : '' %>> <span class="truncate"><%= f.label %></span></label>
                      <input type="number" name="order[<%= f.key %>]" value="<%= selected[f.key] || '' %>" min="0" max="999" aria-label="Position of <%= f.label %>" class="<%= _num %>">
                    </div>
                  <% }) %>
                  <% s.lists.forEach((l) => { %>
                    <div class="<%= _row %>">
                      <label class="<%= _check %>"><input type="checkbox" name="pin" value="<%= l.key %>" <%= selected[l.key] ? 'checked' : '' %>> <i class="bi bi-list-ul text-gray-400" aria-hidden="true"></i> <span class="truncate">List: <%= l.label %></span></label>
                      <input type="number" name="order[<%= l.key %>]" value="<%= selected[l.key] || '' %>" min="0" max="999" aria-label="Position of list <%= l.label %>" class="<%= _num %>">
                    </div>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          </div>
        </details>
      <% }) %>
    </section>

    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="inline-flex items-center gap-1.5 text-sm bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg shadow-sm font-medium transition">
        <i class="bi bi-check-lg" aria-hidden="true"></i> Save
      </button>
      <a href="<%= back.href %>" class="text-sm text-gray-600 dark:text-gray-400 hover:underline">Cancel</a>
    </div>
  </form>

  <% if (resetAction) { %>
    <form method="POST" action="<%= resetAction %>">
      <%- include('../partials/csrfHidden') %>
      <button type="submit" class="text-sm text-red-600 dark:text-red-400 hover:underline"><%= resetLabel %></button>
    </form>
  <% } %>
</div>
