<%- include('../partials/form-update') %>

<% if (typeof jobRoleOptions !== 'undefined' && formData && formData.uuid) { %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
  <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
    <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
    <div class="p-6 sm:p-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-1">Job roles</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
        Held on top of the role above. Access is everything the role and every ticked job role grant together.
        Every job role requires two-factor authentication.
      </p>
      <form method="POST" action="/admin/users/<%= encodeURIComponent(formData.uuid) %>/roles" class="space-y-3">
        <%- include('../partials/csrfHidden') %>
        <% jobRoleOptions.forEach(opt => { %>
          <label class="flex items-start gap-3 rounded-xl border border-gray-200 dark:border-gray-700 px-4 py-3 <%= opt.available ? 'cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800' : 'opacity-60 cursor-not-allowed' %>">
            <input type="checkbox" name="roles" value="<%= opt.slug %>"
              class="mt-1 rounded border-gray-300 dark:border-gray-600 text-green-600 focus:ring-green-500"
              <%= opt.checked ? 'checked' : '' %> <%= opt.available ? '' : 'disabled' %>>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-gray-900 dark:text-gray-100">
                <%= opt.label %>
                <% if (!opt.available) { %><span class="ml-1 text-xs font-normal text-amber-600 dark:text-amber-400">Not available yet</span><% } %>
              </span>
              <span class="block text-sm text-gray-500 dark:text-gray-400"><%= opt.description %></span>
              <span class="block text-xs text-gray-400 dark:text-gray-500 mt-1">
                <%= opt.groups.join(' · ') %>
                · <%= opt.values === 'always' ? 'Sees values' : opt.values === 'never' ? 'No values' : 'Values: per person, below' %>
              </span>
            </span>
          </label>
        <% }) %>
        <label class="flex items-start gap-3 rounded-xl border border-gray-200 dark:border-gray-700 px-4 py-3 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800">
          <input type="checkbox" name="canSeeValues" value="on"
            class="mt-1 rounded border-gray-300 dark:border-gray-600 text-green-600 focus:ring-green-500"
            <%= (typeof canSeeValues !== 'undefined' && canSeeValues) ? 'checked' : '' %>>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-gray-900 dark:text-gray-100">Can see values</span>
            <span class="block text-sm text-gray-500 dark:text-gray-400">
              Day rates, costs, and purchase and project values. Applies to
              <%= (typeof valuesFlagRoles !== 'undefined' ? valuesFlagRoles : []).join(' and ') %>; every other job role's answer is fixed (shown on each role above).
            </span>
          </span>
        </label>
        <div class="pt-2">
          <button type="submit"
            class="text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition">
            Save job roles
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<% if (typeof roleDetails !== 'undefined' && typeof allRoles !== 'undefined') { %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
  <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
    <div class="h-1.5 bg-gradient-to-r from-cyan-500 to-blue-400"></div>
    <div class="p-6 sm:p-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-1">Role Permissions Preview</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">What each role grants when assigned to this user.</p>

      <div class="space-y-4" id="role-preview">
        <% allRoles.forEach(role => {
          const details = roleDetails[role] || {};
          const isSelected = formData.role === role;
        %>
          <details<%= isSelected ? ' open' : '' %> class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" data-role="<%= role %>">
            <summary class="px-4 py-3 cursor-pointer select-none flex items-center gap-2 text-sm font-semibold <%= isSelected ? 'bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-300' : 'bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-200' %> hover:bg-gray-100 dark:hover:bg-gray-700 transition">
              <span class="capitalize"><%= role %></span>
              <% if (isSelected) { %><span class="text-xs bg-green-100 dark:bg-green-800 text-green-700 dark:text-green-200 px-2 py-0.5 rounded-full">Current</span><% } %>
            </summary>
            <div class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300 space-y-3">
              <% if (details.departments && details.departments.length) { %>
                <div>
                  <span class="font-medium text-gray-700 dark:text-gray-200">Departments:</span>
                  <span class="ml-1"><%= details.departments.join(', ') %></span>
                </div>
              <% } %>
              <% if (details.models && details.models.length) { %>
                <div>
                  <span class="font-medium text-gray-700 dark:text-gray-200">Model Access:</span>
                  <div class="mt-1 flex flex-wrap gap-1.5">
                    <% details.models.forEach(m => { %>
                      <span class="inline-flex items-center gap-1 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded text-xs">
                        <strong><%= m.model %></strong>
                        <% m.operations.forEach(op => { %>
                          <span class="<%= (op.ownOnly || op.sitesOnly) ? 'text-amber-600 dark:text-amber-400' : 'text-gray-500 dark:text-gray-400' %>"><%= op.label %><%= op.ownOnly ? '*' : op.sitesOnly ? '†' : '' %></span>
                        <% }) %>
                      </span>
                    <% }) %>
                  </div>
                </div>
              <% } %>
              <% if (details.customRoutes && details.customRoutes.length) { %>
                <div>
                  <span class="font-medium text-gray-700 dark:text-gray-200">Routes:</span>
                  <span class="ml-1 text-xs"><%= details.customRoutes.join(', ') %></span>
                </div>
              <% } %>
              <% if ((!details.departments || !details.departments.length) && (!details.models || !details.models.length)) { %>
                <p class="text-gray-400 dark:text-gray-500 italic">No permissions granted.</p>
              <% } %>
            </div>
          </details>
        <% }) %>
      </div>
      <p class="text-xs text-gray-400 dark:text-gray-500 mt-3">* = own records only · † = their sites only (contracts that name them)</p>
    </div>
  </div>
</div>
<% } %>
