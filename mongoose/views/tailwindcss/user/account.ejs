<!-- Sub-navigation between the account-related pages -->
<div class="max-w-6xl mx-auto mb-4 px-4 sm:px-6 lg:px-8 pt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
  <a href="/user/profile" class="inline-flex items-center gap-1 text-green-600 dark:text-green-400 hover:underline text-sm font-medium">
    <i class="bi bi-person-circle"></i> View Profile
  </a>
  <a href="/user/account/settings/notifications" class="inline-flex items-center gap-1 text-green-600 dark:text-green-400 hover:underline text-sm font-medium">
    <i class="bi bi-bell"></i> Notification Settings
  </a>
</div>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
  <!-- LEFT: TOTP Section -->
  <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
    <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
    <div class="p-6 sm:p-8">
    <div>
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 text-center mb-4">Two-Factor Authentication (TOTP)</h2>

      <% if (!user.totpEnabled && typeof twoFARequired !== 'undefined' && twoFARequired) { %>
        <div class="mb-4 rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
          <i class="bi bi-exclamation-triangle-fill mr-1"></i>
          Your role (<strong class="capitalize"><%= user.role %></strong>) requires two-factor authentication.
          You must enable it below before you can use the rest of the platform.
        </div>
      <% } %>

      <% if (!user.totpEnabled) { %>
        <p class="text-center text-gray-600 dark:text-gray-300 mb-4">Two-Factor Authentication is not enabled for your account.</p>
        <p class="mb-2">Scan the QR code below with your authentication app<br> <small>(e.g., Google Authenticator, Authy).</small></p>
        <p class="text-sm font-semibold text-gray-600">Secret QR:</p>
        <div class="text-center">
          <img src="<%= qrCodeUrl %>" alt="QR Code" class="mx-auto mb-3 max-w-[200px]">
        </div>

        <hr class="my-6 border-t-2 border-line">

        <p class="mb-2">Alternatively, enter this key manually into your authentication app of choice:</p>
        <p class="text-sm font-semibold text-gray-600">Secret Key: <pre class="text-center"><%= secret %></pre></p>
      <% } else { %>
        <div class="text-center py-8">
          <i class="bi bi-shield-check text-green-500 text-5xl"></i>
          <p class="mt-4 text-green-600 dark:text-green-400 font-semibold text-lg">Two-Factor Authentication is enabled.</p>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Your account is protected with an authenticator app.</p>
        </div>
      <% } %>
    </div>

    <% if (!user.totpEnabled) { %>
      <form action="/user/account/verify-totp" method="POST" class="mt-6">
        <%- include('../partials/csrfHidden.ejs') %>
        <label for="totpToken" class="block font-medium mb-1">Enter the 6-digit authentication code:</label>
        <input type="text" name="totpToken" id="totpToken" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code"
          class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500 mb-3">
        <div class="flex justify-center">
          <button type="submit" class="w-full max-w-xs inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium bg-green-600 hover:bg-green-700 text-white transition shadow-sm">
            Verify & Enable 2FA
          </button>
        </div>
      </form>
    <% } else { %>
      <form action="/user/account/disable-totp" method="POST" class="mt-6">
        <%- include('../partials/csrfHidden.ejs') %>
        <div class="mb-3">
          <label for="confirmPassword" class="block font-medium mb-1">Enter your password to confirm:</label>
          <input type="password" name="confirmPassword" id="confirmPassword" required
            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>
        <div class="flex justify-center">
          <button type="submit" class="w-full max-w-xs inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium bg-red-600 hover:bg-red-700 text-white transition shadow-sm"
            data-confirm="Are you sure you want to disable Two-Factor Authentication?">
            <i class="bi bi-shield-x"></i> Disable 2FA
          </button>
        </div>
      </form>
      <form action="/user/account/regenerate-backup-codes" method="POST" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
        <%- include('../partials/csrfHidden.ejs') %>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
          Backup codes let you sign in if you lose your authenticator. Regenerating invalidates all previous codes.
        </p>
        <div class="mb-3">
          <label for="regenConfirmPassword" class="block font-medium mb-1">Enter your password to confirm:</label>
          <input type="password" name="confirmPassword" id="regenConfirmPassword" required
            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>
        <div class="flex justify-center">
          <button type="submit" class="w-full max-w-xs inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium bg-green-600 hover:bg-green-700 text-white transition shadow-sm">
            <i class="bi bi-key"></i> Regenerate Backup Codes
          </button>
        </div>
      </form>
    <% } %>
    </div>
  </div>

  <!-- RIGHT: Account Details + Change Password -->
  <div class="space-y-6">
    <!-- Account Details -->
    <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
      <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
      <div class="p-6 sm:p-8">
      <h1 class="text-xl font-bold text-center mb-6 text-gray-900 dark:text-gray-100">Account Details</h1>

      <form action="/user/account/settings" method="POST" class="space-y-4">
        <%- include('../partials/csrfHidden.ejs') %>
        <div>
          <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Username</label>
          <input type="text" name="newUsername" id="username" value="<%= user.username %>" required class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email</label>
          <input type="email" name="newEmail" id="email" value="<%= user.email %>" required class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500">
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Changing your email will require re-verification.</p>
        </div>
        <div class="flex justify-end gap-2 mt-2">
          <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium bg-green-600 hover:bg-green-700 text-white transition shadow-sm">
            Update Details
          </button>
        </div>
      </form>
      </div>
    </div>

    <!-- Change Password -->
    <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
      <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
      <div class="p-6 sm:p-8">
      <h1 class="text-xl font-bold text-center mb-6 text-gray-900 dark:text-gray-100">Change Password</h1>
      <form action="/user/account/change-password" method="POST" class="space-y-4">
        <%- include('../partials/csrfHidden.ejs') %>
        <div>
          <label for="currentPassword" class="block font-medium mb-1">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" required class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>
        <div>
          <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">New Password</label>
          <input type="password" id="newPassword" name="newPassword" required minlength="6" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500">
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Minimum 6 characters.</p>
        </div>
        <div>
          <label for="confirmNewPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirm New Password</label>
          <input type="password" id="confirmNewPassword" name="confirmNewPassword" required minlength="6" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>
        <div class="flex justify-end gap-2 mt-2">
          <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium bg-green-600 hover:bg-green-700 text-white transition shadow-sm">
            Update Password
          </button>
        </div>
      </form>
      </div>
    </div>
  </div>
</div>

<!-- Navigation style (navPreferenceController). Applies on the next page load. -->
<% const _navPref = locals.navPreference || { style: 'tabs', pinned: null, source: 'default' }; %>
<% const _navStyles = locals.navStyles || []; %>
<% const _pinnable = (locals.nav && locals.nav.items ? locals.nav.items : []).filter((i) => i.special !== 'create' && i.slug !== 'user'); %>
<% const _pinnedNow = Array.isArray(_navPref.pinned) ? _navPref.pinned : ['human-resources', 'attendance', 'documents', 'finance', 'construction-industry-scheme']; %>
<div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden mt-6" id="navigation-style">
  <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
  <div class="p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100">Navigation</h1>
      <% if (_navPref.source === 'user') { %>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700">Your choice</span>
      <% } else { %>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700"><%= _navPref.source === 'company' ? 'Company default' : 'Standard' %></span>
      <% } %>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-5">Choose how the header looks for you. It changes on the next page you open. The company default is <strong><%= (_navStyles.find((s) => s.value === locals.navCompanyDefault) || {}).label || 'Icon tabs' %></strong>.</p>

    <form action="/user/account/navigation" method="POST" class="space-y-5">
      <%- include('../partials/csrfHidden.ejs') %>
      <fieldset>
        <legend class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Style</legend>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <% _navStyles.forEach((s) => { %>
          <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition <%= _navPref.style === s.value ? 'border-green-400 dark:border-green-600 bg-green-50 dark:bg-green-900/20' : 'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800' %>">
            <input type="radio" name="navStyle" value="<%= s.value %>" <%= _navPref.style === s.value ? 'checked' : '' %> class="mt-1 text-green-600 focus:ring-green-500">
            <span>
              <span class="block text-sm font-medium text-gray-900 dark:text-gray-100"><%= s.label %></span>
              <span class="block text-xs text-gray-500 dark:text-gray-400"><%= s.description %></span>
            </span>
          </label>
          <% }) %>
        </div>
      </fieldset>

      <% if (_pinnable.length) { %>
      <fieldset>
        <legend class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Pinned to the command rail</legend>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Only the Command rail style uses these. Everything else is under its More menu.</p>
        <div class="flex flex-wrap gap-2">
          <% _pinnable.forEach((item) => { %>
          <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 cursor-pointer">
            <input type="checkbox" name="pinned" value="<%= item.slug %>" <%= _pinnedNow.includes(item.slug) ? 'checked' : '' %> class="rounded text-green-600 focus:ring-green-500">
            <i class="bi <%= item.icon %>" aria-hidden="true"></i> <%= item.label %>
          </label>
          <% }) %>
        </div>
      </fieldset>
      <% } %>

      <div class="flex flex-wrap justify-end gap-2">
        <% if (_navPref.source === 'user') { %>
        <button type="submit" formaction="/user/account/navigation/reset" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 text-sm font-medium transition shadow-sm">
          Use the company default
        </button>
        <% } %>
        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium bg-green-600 hover:bg-green-700 text-white transition shadow-sm">
          Save navigation
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Active Sessions -->
<div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden mt-6">
  <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
  <div class="p-6 sm:p-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100">Active Sessions</h1>
    <% if (sessions.filter(s => !s.isCurrent).length > 0) { %>
      <form action="/user/account/logout-all-sessions" method="POST">
        <%- include('../partials/csrfHidden.ejs') %>
        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium bg-red-600 hover:bg-red-700 text-white transition shadow-sm"
          data-confirm="Log out all other sessions? Other devices will need to sign in again.">
          <i class="bi bi-box-arrow-right"></i> Log out all other sessions
        </button>
      </form>
    <% } %>
  </div>

  <% if (sessions.length === 0) { %>
    <div class="text-center text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 p-6 rounded-xl">
      <p>No active sessions.</p>
    </div>
  <% } else { %>
    <div class="overflow-auto rounded-xl border border-gray-200 dark:border-gray-700">
      <table class="min-w-full text-sm text-left">
        <thead class="bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
          <tr>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">IP Address</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Browser</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Platform</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Login Time</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Last Activity</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Idle</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Session Expiration</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Secure</th>
            <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-900">
          <% sessions.forEach(session => { %>
            <tr class="border-t border-gray-100 dark:border-gray-800 <%= session.isCurrent ? 'bg-green-50 dark:bg-green-900/20' : '' %>">
              <td class="px-4 py-2.5 font-medium text-gray-900 dark:text-gray-100 whitespace-nowrap">
                <%= session.ip %>
                <% if (session.isCurrent) { %>
                  <span class="ml-1 inline-flex items-center text-xs bg-green-600 text-white px-2 py-0.5 rounded-full">Current</span>
                <% } %>
              </td>
              <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300"><%= session.browser %></td>
              <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300"><%= session.platform.replace(/['"]+/g, '') || 'Unknown' %></td>
              <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300"><%= session.loginTime ? slimDateTime(session.loginTime, ['includeTime']) : (session.isCurrent ? 'Just now' : '—') %></td>
              <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300"><%= session.lastActivity ? slimDateTime(session.lastActivity, ['includeTime']) : '—' %></td>
              <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300"><%= session.idleFor %></td>
              <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300">
                <%= slimDateTime(session.expires, ['includeTime']) %><br>
                <span class="text-xs text-gray-500 dark:text-gray-400">(<%= session.timeUntilExpiry %>)</span>
              </td>
              <td class="px-4 py-2.5 font-medium <%= session.secure ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %>">
                <%= session.secure ? 'Yes' : 'No' %>
              </td>
              <td class="px-4 py-2.5">
                <% if (session.isCurrent) { %>
                  <span class="text-xs text-gray-400 dark:text-gray-500 italic">In use</span>
                <% } else { %>
                  <form action="/user/account/logout-session" method="POST">
                    <%- include('../partials/csrfHidden.ejs') %>
                    <input type="hidden" name="sessionId" value="<%= session.sessionId %>">
                    <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-red-600 hover:bg-red-700 text-white transition shadow-sm"
                      data-confirm="Log out this session?">
                      Logout
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  </div>
</div>
</div>