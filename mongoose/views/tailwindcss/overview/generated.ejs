<%#
  Generated overview page (config/overviews → services/overviewEngine.js).
  page.kind 'area': cards per child node with summary figures (depth 1).
  page.kind 'node': one model's overview (depth 2).
  Every figure links one level down, to its list pre-filtered with ?view=.
%>
<%
  const _sevValue = (f) => {
    if (f.value === null) return 'text-gray-400 dark:text-gray-500';
    if (f.value > 0 && f.severity === 'critical') return 'text-red-600 dark:text-red-400';
    if (f.value > 0 && f.severity === 'warning') return 'text-amber-600 dark:text-amber-400';
    return 'text-gray-900 dark:text-gray-100';
  };
  const _sevCard = (f) => {
    if (f.value > 0 && f.severity === 'critical') return 'border-red-300 dark:border-red-700 bg-red-50 dark:bg-red-900/20';
    if (f.value > 0 && f.severity === 'warning') return 'border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20';
    return 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900';
  };
  const _fmt = (v) => (v === null || v === undefined ? '—' : Number(v).toLocaleString('en-GB'));
%>
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%- include('../partials/breadcrumbs', { crumbs: page.crumbs, current: page.title }) %>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <% if (page.icon) { %><i class="bi <%= page.icon %> text-green-600 dark:text-green-400" aria-hidden="true"></i><% } %>
        <%= page.title %>
      </h1>
      <% if (page.description) { %><p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= page.description %></p><% } %>
    </div>
    <div class="flex flex-wrap gap-2 print:hidden">
      <% page.actions.forEach((a) => { %>
        <a href="<%= a.href %>" class="inline-flex items-center gap-1.5 text-sm bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg shadow-sm font-medium transition">
          <i class="bi <%= a.icon || 'bi-plus-lg' %>" aria-hidden="true"></i> <%= a.label %>
        </a>
      <% }) %>
      <% if (page.kind === 'node' && page.listHref) { %>
        <a href="<%= page.listHref %>" class="inline-flex items-center gap-1 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 text-sm font-medium transition shadow-sm">
          <%= page.listLabel %> <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
      <% } %>
    </div>
  </div>

  <% if (page.kind === 'area') { %>
    <% if (!page.cards.length) { %>
      <p class="text-sm text-gray-500 dark:text-gray-400 italic">There's nothing in this area you have access to.</p>
    <% } %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% page.cards.forEach((card) => { %>
        <section class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm overflow-hidden flex flex-col">
          <div class="px-5 pt-5 pb-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 flex items-center gap-2">
                <% if (card.icon) { %><i class="bi <%= card.icon %> text-gray-400" aria-hidden="true"></i><% } %>
                <a href="<%= card.href %>" class="hover:text-green-700 dark:hover:text-green-400"><%= card.label %></a>
              </h2>
              <% if (card.description) { %><p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= card.description %></p><% } %>
            </div>
          </div>
          <ul class="divide-y divide-gray-100 dark:divide-gray-800 border-t border-gray-100 dark:border-gray-800 flex-grow">
            <% card.figures.forEach((f) => { %>
              <li>
                <a href="<%= f.href %>" class="flex items-center justify-between gap-4 px-5 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                  <span class="text-sm text-gray-700 dark:text-gray-300"><%= f.label %></span>
                  <span class="text-lg font-semibold tabular-nums <%= _sevValue(f) %>"><%= f.display || _fmt(f.value) %></span>
                </a>
              </li>
            <% }) %>
          </ul>
          <a href="<%= card.href %>" class="px-5 py-3 text-sm font-medium text-green-700 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 border-t border-gray-100 dark:border-gray-800 transition">
            <%= card.linkLabel %> <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </a>
        </section>
      <% }) %>
    </div>
  <% } else { %>

    <% if (page.figures.length) { %>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-4 mb-8">
        <% page.figures.forEach((f) => { %>
          <a href="<%= f.href %>" title="<%= f.hint || ('Show these in the list') %>"
             class="block border rounded-2xl shadow-sm p-4 hover:shadow-md hover:border-green-400 dark:hover:border-green-600 transition <%= _sevCard(f) %>">
            <p class="text-2xl font-bold tabular-nums <%= _sevValue(f) %>"><%= f.display || _fmt(f.value) %></p>
            <p class="mt-1 text-xs font-medium text-gray-600 dark:text-gray-400 leading-snug"><%= f.label %></p>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (page.breakdowns.length) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <% page.breakdowns.forEach((b) => { %>
          <section class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-4">
            <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3"><%= b.label %></h2>
            <div class="flex flex-wrap gap-2">
              <% b.segments.forEach((s) => { %>
                <% if (s.href) { %>
                  <a href="<%= s.href %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-green-50 dark:hover:bg-green-900/30 hover:text-green-700 dark:hover:text-green-400 transition">
                    <%= s.label %> <strong class="tabular-nums"><%= _fmt(s.count) %></strong>
                  </a>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200">
                    <%= s.label %> <strong class="tabular-nums"><%= _fmt(s.count) %></strong>
                  </span>
                <% } %>
              <% }) %>
            </div>
          </section>
        <% }) %>
      </div>
    <% } %>

    <% if (page.lists.length) { %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <% page.lists.forEach((l) => { %>
          <% const _border = l.severity === 'critical' ? 'border-red-300 dark:border-red-700' : l.severity === 'warning' ? 'border-amber-300 dark:border-amber-700' : 'border-gray-200 dark:border-gray-700'; %>
          <section class="bg-white dark:bg-gray-900 border <%= _border %> rounded-2xl shadow-sm overflow-hidden min-w-0">
            <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-gray-100 dark:border-gray-800">
              <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= l.title %></h2>
              <a href="<%= l.href %>" class="text-xs font-medium text-green-700 dark:text-green-400 hover:underline whitespace-nowrap"><%= l.linkLabel || ('View all ' + _fmt(l.total)) %> <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-800">
                  <tr>
                    <% l.columns.forEach((c) => { %>
                      <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= c %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                  <% l.rows.forEach((r) => { %>
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                      <% r.cells.forEach((cell, i) => { %>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-300 whitespace-nowrap">
                          <% if (i === 0 && r.href) { %><a href="<%= r.href %>" class="font-medium text-green-700 dark:text-green-400 hover:underline"><%= cell %></a><% } else { %><%= cell %><% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        <% }) %>
      </div>
    <% } %>

    <% (page.partials || []).forEach((p) => { %>
      <%# Custom panels with their own markup (forms, modals); names come from code, never from input %>
      <%- include(p.partial, p.locals) %>
    <% }) %>

    <% if (page.related.length) { %>
      <section class="mb-8">
        <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Elsewhere</h2>
        <div class="flex flex-wrap gap-3">
          <% page.related.forEach((f) => { %>
            <a href="<%= f.href %>" class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl border shadow-sm text-sm hover:border-green-400 dark:hover:border-green-600 transition <%= _sevCard(f) %>">
              <span class="text-gray-700 dark:text-gray-300"><% if (f.group) { %><span class="text-gray-500 dark:text-gray-400"><%= f.group %> · </span><% } %><%= f.label %></span>
              <strong class="tabular-nums <%= _sevValue(f) %>"><%= f.display || _fmt(f.value) %></strong>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (!page.figures.length && !page.lists.length) { %>
      <p class="text-sm text-gray-500 dark:text-gray-400 italic">Nothing to show here yet.</p>
    <% } %>
  <% } %>
</div>
