<%#
  Upload a workbook to import (Job Reg or WEEKLY ATTENDANCE).
  Locals: crumbs, action, heading, icon, intro, points[]
%>
<%
  const card = 'bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm';
  const primaryBtn = 'text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition';
%>
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%- include('../partials/breadcrumbs', { crumbs, current: 'Import' }) %>

  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2 mb-2">
    <i class="bi <%= icon %> text-green-600 dark:text-green-400" aria-hidden="true"></i>
    <%= heading %>
  </h1>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6 max-w-3xl"><%= intro %></p>

  <div class="grid lg:grid-cols-5 gap-6">
    <form method="POST" action="<%= action %>" enctype="multipart/form-data" class="<%= card %> p-6 lg:col-span-2 space-y-4">
      <%- include('../partials/csrfHidden') %>
      <div>
        <label for="workbook" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Workbook (.xlsx)</label>
        <input id="workbook" name="workbook" type="file" required
               accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
               class="block w-full text-sm text-gray-700 dark:text-gray-300 file:mr-3 file:px-4 file:py-2 file:rounded-lg file:border-0 file:bg-green-50 file:text-green-700 dark:file:bg-green-900/40 dark:file:text-green-300">
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Up to 10 MB. Nothing is saved yet: the next page shows what will happen.</p>
      </div>
      <button type="submit" class="<%= primaryBtn %>"><i class="bi bi-upload" aria-hidden="true"></i> Upload and check</button>
    </form>

    <div class="<%= card %> p-6 lg:col-span-3">
      <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">How it's read</h2>
      <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300 list-disc pl-5">
        <% points.forEach((p) => { %><li><%= p %></li><% }) %>
      </ul>
    </div>
  </div>
</div>
