<%#
  Upload a workbook to import (Job Reg or WEEKLY ATTENDANCE).
  Locals: crumbs, action, heading, icon, intro, points[],
          uploads[] (workbookImportStore.recentUploads: saved, plus unexpired, newest first)
%>
<%
  const card = 'bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm';
  const primaryBtn = 'text-sm bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg shadow-sm font-medium transition';
  const th = 'px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 whitespace-nowrap';
  const td = 'px-4 py-3 text-gray-900 dark:text-gray-100 align-top';
  const when = (d) => d ? new Date(d).toLocaleString('en-GB', { timeZone: 'Europe/London', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '';
  const list = typeof uploads !== 'undefined' && Array.isArray(uploads) ? uploads : [];
%>
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%- include('../partials/breadcrumbs', { crumbs, current: 'Import' }) %>

  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2 mb-2">
    <i class="bi <%= icon %> text-green-600 dark:text-green-400" aria-hidden="true"></i>
    <%= heading %>
  </h1>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6 max-w-3xl"><%= intro %></p>

  <div class="grid lg:grid-cols-5 gap-6">
    <form method="POST" action="<%= action %>" enctype="multipart/form-data" class="<%= card %> p-6 lg:col-span-2 space-y-4">
      <%- include('../partials/csrfHidden') %>
      <div>
        <label for="workbook" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Workbook (.xlsx)</label>
        <input id="workbook" name="workbook" type="file" required
               accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
               class="block w-full text-sm text-gray-700 dark:text-gray-300 file:mr-3 file:px-4 file:py-2 file:rounded-lg file:border-0 file:bg-green-50 file:text-green-700 dark:file:bg-green-900/40 dark:file:text-green-300">
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Up to 10 MB. Nothing is saved yet: the next page shows what will happen.</p>
      </div>
      <button type="submit" class="<%= primaryBtn %>"><i class="bi bi-upload" aria-hidden="true"></i> Upload and check</button>
    </form>

    <div class="<%= card %> p-6 lg:col-span-3">
      <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">How it's read</h2>
      <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300 list-disc pl-5">
        <% points.forEach((p) => { %><li><%= p %></li><% }) %>
      </ul>
    </div>
  </div>

  <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-8 mb-3">Saved and recent uploads</h2>
  <% if (!list.length) { %>
    <div class="text-sm text-gray-400 dark:text-gray-500 p-6 rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 text-center">
      No uploads waiting. Uploads are kept for a day, or until imported if you save them.
    </div>
  <% } else { %>
    <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr><th class="<%= th %>">File</th><th class="<%= th %>">Uploaded</th><th class="<%= th %>">Status</th><th class="<%= th %>"><span class="sr-only">Open</span></th></tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-900">
          <% list.forEach((u) => { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
              <td class="<%= td %> font-mono text-xs break-all"><%= u.fileName %></td>
              <td class="<%= td %> whitespace-nowrap"><%= when(u.createdAt) %><% if (u.by) { %><div class="text-xs text-gray-500 dark:text-gray-400"><%= u.by %></div><% } %></td>
              <td class="<%= td %>">
                <% if (u.importedAt) { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700">Imported <%= when(u.importedAt) %></span>
                  <div class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= u.summary %></div>
                <% } else if (u.saved) { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-700">Saved <%= when(u.savedAt) %></span>
                  <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Kept until imported or deleted</div>
                <% } else { %>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700">Not imported</span>
                  <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Expires <%= when(u.expiresAt) %></div>
                <% } %>
              </td>
              <td class="<%= td %> text-right whitespace-nowrap">
                <a href="<%= action %>/<%= u.uuid %>" class="text-xs px-3 py-1.5 rounded-lg <%= u.importedAt ? 'border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800' : 'bg-green-600 hover:bg-green-700 text-white shadow-sm' %> font-medium transition"><%= u.importedAt ? 'View' : u.saved ? 'Carry on' : 'Check and import' %></a>
                <form method="POST" action="<%= action %>/<%= u.uuid %>/delete" class="inline">
                  <%- include('../partials/csrfHidden') %>
                  <button type="submit" class="text-xs px-2 py-1.5 text-red-700 dark:text-red-400 hover:underline" aria-label="Delete the upload <%= u.fileName %>"><i class="bi bi-trash" aria-hidden="true"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
