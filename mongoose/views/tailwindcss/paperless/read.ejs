<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%
    // The queue this document is waiting in, if any
    const _isStatement = /supplier\s*statement/i.test(doc.documentType?.name || '');
    const _queue = doc.deletedInPaperlessAt ? null
      : doc.processingState === 'awaiting_entry' && !doc.excludedReason ? { key: 'needs-entry', label: 'Needs Data Entry' }
      : doc.processingState === 'entered' && !doc.excludedReason ? { key: 'ready', label: 'Ready for KashFlow' }
      : _isStatement && doc.classifiedAt && doc.statementReviewed !== true ? { key: 'statements', label: 'Statements to Review' }
      : null;
    const _fmt = (d) => d ? new Date(d).toLocaleString('en-GB', { timeZone: 'Europe/London' }) : '—';
    const _canManage = typeof canGroup === 'function' && canGroup('documents', 'manage');
    const _csrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
    const _linked = !!(doc.kashflowPurchaseNumber || doc.kashflowPermalink);
    const _pill = 'text-[11px] px-2 py-0.5 rounded-full border font-medium';
    const _tone = {
      green: 'bg-green-100 text-green-800 border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-700',
      amber: 'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:border-amber-700',
      blue: 'bg-blue-100 text-blue-800 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-700',
      red: 'bg-red-100 text-red-800 border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-700',
      slate: 'bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-900/40 dark:text-slate-300 dark:border-slate-700',
    };
    const _state = doc.deletedInPaperlessAt ? { label: 'Deleted in Paperless', tone: 'red' }
      : doc.excludedReason === 'not_for_kashflow' ? { label: 'Not for KashFlow', tone: 'slate' }
      : doc.processingState === 'awaiting_entry' ? { label: 'Needs data entry', tone: 'amber' }
      : doc.processingState === 'entered' ? { label: 'Ready for KashFlow', tone: 'blue' }
      : doc.processingState === 'sent' ? { label: 'In KashFlow', tone: 'green' }
      : doc.processingState === 'manual_kashflow' ? { label: 'Added in KashFlow by hand', tone: 'green' }
      : null;
    const _hasAddedTag = hasTag(doc.tags, 'added');
    const _sentUnlinked = doc.processingState === 'sent' && doc.kashflowPurchaseId == null && !doc.deletedInPaperlessAt;
    const _hasAlerts = !!(doc.deletedInPaperlessAt || doc.excludedReason === 'not_for_kashflow' || (_hasAddedTag && !doc.kashflowPurchaseNumber && !doc.kashflowPermalink) || _sentUnlinked || hasDrift || hashDuplicate);
    const _ocr = (doc.ocrText || '').trim();
    const _cfs = Array.isArray(doc.customFields) ? doc.customFields : [];
    const _btn = 'inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium transition shadow-sm';
    const _btnOutline = `${_btn} border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800`;
    const _card = 'bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm';
    const _h2 = 'font-semibold text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400';
  %>
  <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    <% if (_queue) { %>
      <a href="/paperless/queues/<%= _queue.key %>" class="text-green-700 dark:text-green-400 hover:underline">← <%= _queue.label %></a>
    <% } %>
    <a href="/paperless/ocr" class="text-green-700 dark:text-green-400 hover:underline"><%= _queue ? 'All documents' : '← All documents' %></a>
  </nav>

  <%# Header: what it is, where it stands, and what can be done with it %>
  <header class="mt-2 mb-6 flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4" data-document-header>
    <div class="min-w-0">
      <h1 class="text-2xl font-bold break-words"><%= title %></h1>
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
        <span class="font-mono text-xs">#<%= doc.paperlessId %></span>
        <% if (doc.correspondent?.name) { %><span aria-hidden="true">·</span><span><%= doc.correspondent.name %></span><% } %>
        <% if (doc.documentType?.name) { %><span aria-hidden="true">·</span><span><%= doc.documentType.name %></span><% } %>
        <% if (doc.created) { %><span aria-hidden="true">·</span><span><%= new Date(doc.created).toLocaleDateString('en-GB', { timeZone: 'Europe/London' }) %></span><% } %>
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <% if (_state) { %><span class="<%= _pill %> <%= _tone[_state.tone] %>" data-state-badge><%= _state.label %></span><% } %>
        <% if (doc.kashflowPurchaseNumber) { %><span class="<%= _pill %> <%= _tone.green %>">Purchase #<%= doc.kashflowPurchaseNumber %></span><% } %>
        <% if (hasDrift) { %><span class="<%= _pill %> <%= _tone.amber %>">Paperless field out of sync</span><% } %>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 lg:justify-end lg:shrink-0">
      <a href="/paperless/ocr/<%= doc.paperlessId %>/entry" class="<%= _btn %> bg-green-600 hover:bg-green-700 text-white">
        <i class="bi bi-pencil-square"></i> Data entry
      </a>
      <a href="/paperless/ocr/<%= doc.paperlessId %>/draft" class="<%= _btnOutline %>">
        <i class="bi bi-receipt"></i> <%= /subcontract/i.test(doc.documentType?.name || '') ? 'Subcontractor Invoice Draft' : 'Purchase Draft' %>
      </a>
      <a href="/paperless/ocr/<%= doc.paperlessId %>/match" class="<%= _btnOutline %>">
        <i class="bi bi-link-45deg"></i> Match Purchase
      </a>
      <a href="<%= locals.paperlessUiBase || '' %>/documents/<%= doc.paperlessId %>" target="_blank" rel="noopener noreferrer" class="<%= _btnOutline %>">
        <i class="bi bi-box-arrow-up-right text-xs"></i> Open in Paperless
      </a>
    </div>
  </header>

  <%# Anything that needs attention, before the detail %>
  <% if (_hasAlerts) { %>
  <div class="space-y-3 mb-6">
    <% if (doc.deletedInPaperlessAt) { %>
      <div class="p-4 rounded-xl border border-red-300 dark:border-red-700 bg-red-50 dark:bg-red-900/20 text-sm text-red-800 dark:text-red-300">
        <div class="font-semibold flex items-center gap-1"><i class="bi bi-trash3-fill"></i> Deleted in Paperless</div>
        <div class="mt-1">This document is no longer in Paperless (noticed <%= new Date(doc.deletedInPaperlessAt).toLocaleString('en-GB') %>).
          <% if (doc.kashflowPurchaseNumber) { %>The KashFlow link (purchase #<%= doc.kashflowPurchaseNumber %>) is stranded on this dead record. <% } %>
          If the same invoice was re-uploaded under a new Paperless ID, use
          <a href="/paperless/ocr/<%= doc.paperlessId %>/match" class="underline font-medium hover:no-underline">Match &rarr; Replacement Document</a>
          to move it onto the live copy. Otherwise you can remove this record.</div>
        <% if (_canManage) { %>
        <form method="POST" action="/paperless/ocr/<%= doc.paperlessId %>/remove" class="mt-3"
              data-confirm="Remove this deleted-in-Paperless record from the app?">
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <button type="submit" class="text-xs px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white shadow-sm font-medium transition">Remove record</button>
        </form>
        <% } %>
      </div>
    <% } %>

    <% if (doc.excludedReason === 'not_for_kashflow') { %>
      <div class="p-4 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm" data-not-for-kashflow>
        <div class="font-semibold"><i class="bi bi-slash-circle"></i> Not for KashFlow</div>
        <div class="mt-1"><%= doc.excludedNote || '(tagged in Paperless, no reason given)' %></div>
        <div class="mt-1 text-xs text-gray-600 dark:text-gray-400"><% if (doc.excludedReasonChanged?.at) { %><%= _fmt(doc.excludedReasonChanged.at) %><%= doc.excludedReasonChanged.by?.name ? ` by ${doc.excludedReasonChanged.by.name}` : '' %>. <% } %>Undo it on the <a href="/paperless/ocr/<%= doc.paperlessId %>/entry" class="underline">entry screen</a>.</div>
      </div>
    <% } %>

    <%# Resolved by tag id or known name, so a Paperless rename does not
        silently hide this warning. hasTag comes from res.locals. %>
    <% if (_hasAddedTag && !_linked) { %>
      <div class="p-4 rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-300 text-sm">
        <div class="font-semibold flex items-center gap-1"><i class="bi bi-exclamation-triangle-fill"></i> KashFlow linkage missing</div>
        <div class="mt-1">This document is tagged <strong>added</strong> but has no KashFlow Purchase Number recorded. It may have been sent outside this system.
          Enter the KashFlow Purchase Number in the <strong>"KashFlow Purchase Number"</strong> custom field at
          <a href="<%= locals.paperlessUiBase || '' %>/documents/<%= doc.paperlessId %>" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline font-medium">Paperless document <%= doc.paperlessId %></a>,
          then re-fetch this document to link it automatically.
        </div>
      </div>
    <% } %>

    <% if (_sentUnlinked) { %>
      <%# Marked sent with no purchase: e.g. a split copy that inherited `added` (#1178). Unlink moves it back %>
      <div class="p-4 rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 text-amber-900 dark:text-amber-200 text-sm" data-sent-unlinked>
        <div class="font-semibold">Marked In KashFlow, but not linked to any purchase</div>
        <div class="mt-1">If it isn't in KashFlow, move it back so it can be entered and sent. If it is, use Match Purchase to link it instead.</div>
        <% if (_canManage) { %>
        <form method="POST" action="/paperless/ocr/<%= doc.paperlessId %>/unlink" class="mt-3 flex flex-wrap items-center gap-3 text-xs">
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <label class="inline-flex items-center gap-1.5">
            <input type="checkbox" name="confirm" value="yes" required>
            This invoice isn't in KashFlow
          </label>
          <button type="submit" class="px-3 py-1.5 rounded-lg border border-amber-500 hover:bg-amber-100 dark:hover:bg-amber-900/40 font-medium transition">Back to Needs Data Entry</button>
        </form>
        <% } %>
      </div>
    <% } %>

    <% if (hasDrift) { %>
      <div class="p-4 rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-300 text-sm" data-drift>
        <div class="font-semibold flex items-center gap-1"><i class="bi bi-exclamation-triangle-fill"></i> Custom field out of sync</div>
        <dl class="mt-2 space-y-0.5">
          <div class="flex flex-wrap gap-x-2"><dt>This app's KashFlow Purchase Id:</dt><dd class="font-mono text-xs self-center"><%= doc.kashflowPurchaseId ?? '(none)' %></dd></div>
          <div class="flex flex-wrap gap-x-2"><dt>Paperless cached field:</dt><dd class="font-mono text-xs self-center"><%= cfKashflowPurchaseId ?? '(none)' %></dd></div>
        </dl>
        <% if (doc.kashflowPurchaseId != null) { %>
          <div class="mt-2 text-xs">The KashFlow Purchase Id was not written back to Paperless. Use the button below to sync it.</div>
          <% if (_canManage) { %>
          <form method="POST" action="/paperless/ocr/<%= doc.paperlessId %>/sync-fields" class="mt-2">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button type="submit" class="text-xs px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white shadow-sm font-medium transition">Sync Paperless custom fields</button>
          </form>
          <% } %>
        <% } else { %>
          <div class="mt-2 text-xs">Paperless has a KashFlow id but this app does not. Re-ingest or check send logs.</div>
          <% if (_canManage) { %>
          <form method="POST" action="/paperless/ocr/<%= doc.paperlessId %>/ingest" class="mt-2">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button type="submit" class="text-xs px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white shadow-sm font-medium transition">Re-ingest document</button>
          </form>
          <% } %>
        <% } %>
      </div>
    <% } %>

    <% if (hashDuplicate) { %>
      <div class="p-4 rounded-xl border border-blue-300 dark:border-blue-700 bg-blue-50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-300 text-sm">
        <strong>Possible re-upload detected.</strong>
        A document with the same content hash already exists as
        <a href="/paperless/ocr/<%= hashDuplicate.paperlessId %>" class="underline font-medium">Document #<%= hashDuplicate.paperlessId %></a>.
        If this is a re-upload, you can send that document to KashFlow instead.
      </div>
    <% } %>
  </div>
  <% } %>

  <div class="grid lg:grid-cols-3 gap-6 items-start">
    <%# Main column: what the document says %>
    <div class="lg:col-span-2 space-y-6 min-w-0">
      <section class="<%= _card %>">
        <div class="flex items-center justify-between gap-2 px-4 pt-4 pb-3">
          <h2 class="<%= _h2 %>">OCR Text</h2>
          <% if (_ocr) { %><span class="text-xs text-gray-500 dark:text-gray-400"><%= _ocr.split('\n').length %> lines</span><% } %>
        </div>
        <% if (_ocr) { %>
          <pre class="whitespace-pre-wrap break-words font-mono text-xs leading-relaxed max-h-[60vh] overflow-auto mx-4 mb-4 p-4 rounded-xl bg-gray-50 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-100 dark:border-gray-700" tabindex="0" aria-label="OCR text"><%= _ocr %></pre>
        <% } else { %>
          <div class="mx-4 mb-4 text-sm text-gray-400 dark:text-gray-500 p-6 rounded-xl border border-dashed border-gray-200 dark:border-gray-700 text-center">No OCR text for this document.</div>
        <% } %>
      </section>

      <section class="<%= _card %>">
        <h2 class="<%= _h2 %> px-4 pt-4 pb-3">Custom Fields</h2>
        <% if (_cfs.length > 0) { %>
          <div class="overflow-x-auto border-t border-gray-200 dark:border-gray-700">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
              <thead class="bg-gray-50 dark:bg-gray-800">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Field</th>
                  <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Value</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                <% _cfs.forEach(cf => { %>
                  <tr class="align-top">
                    <td class="px-4 py-2 font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap"><%= cf.fieldName || '-' %></td>
                    <td class="px-4 py-2 text-gray-900 dark:text-white">
                      <% const _v = (typeof cf.value === 'object' && cf.value !== null) ? JSON.stringify(cf.value, null, 2) : (cf.value ?? ''); %>
                      <% if (_v === '') { %><span class="text-gray-400 dark:text-gray-500">—</span><% } else { %><div class="whitespace-pre-wrap break-words max-w-full"><%= _v %></div><% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="mx-4 mb-4 text-sm text-gray-400 dark:text-gray-500 p-6 rounded-xl border border-dashed border-gray-200 dark:border-gray-700 text-center">No custom fields found.</div>
        <% } %>
      </section>
    </div>

    <%# Side column: KashFlow, document details, ingest %>
    <aside class="space-y-6 min-w-0">
      <section class="rounded-2xl shadow-sm p-4 border <%= _linked ? 'border-green-300 dark:border-green-700 bg-green-50 dark:bg-green-900/20' : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900' %>" data-kashflow-card>
        <h2 class="<%= _h2 %> mb-3">KashFlow</h2>
        <% if (_linked) { %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="text-xs text-green-800 dark:text-green-300">Linked purchase</div>
              <div class="text-2xl font-bold text-green-900 dark:text-green-200"><%= doc.kashflowPurchaseNumber ? `#${doc.kashflowPurchaseNumber}` : 'Linked' %></div>
              <% if (doc.kashflowPurchaseId) { %><div class="font-mono text-xs text-green-800 dark:text-green-300">Id <%= doc.kashflowPurchaseId %></div><% } %>
            </div>
            <a href="https://app.kashflow.com/#purchases<%= doc.kashflowPurchaseNumber ? `/${doc.kashflowPurchaseNumber}` : '' %>" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium border border-green-400 dark:border-green-600 text-green-800 dark:text-green-200 hover:bg-green-100 dark:hover:bg-green-900/40 transition">
              Open <i class="bi bi-box-arrow-up-right"></i>
            </a>
          </div>
          <% if (doc.lastSentAt) { %>
            <% const _modifiedAfterSent = doc.modified && doc.modifiedAtLastSend && new Date(doc.modified) > new Date(doc.modifiedAtLastSend); %>
            <div class="mt-3 text-xs text-green-800 dark:text-green-300">Last sent <%= _fmt(doc.lastSentAt) %> via <%= doc.lastSendMode || '-' %> (status <%= doc.lastSendStatus ?? '-' %>)</div>
            <% if (_modifiedAfterSent) { %>
              <div class="mt-2 flex items-start gap-1.5 text-xs text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-lg px-2.5 py-1.5" data-modified-after-send>
                <i class="bi bi-exclamation-triangle-fill mt-0.5"></i>
                <span>Document modified after last send. The KashFlow purchase may be out of date.</span>
              </div>
            <% } %>
          <% } %>
          <%# Removing the KashFlow fields in Paperless doesn't stick: hcs-app writes them back while it holds the link. %>
          <% if (_canManage) { %>
          <details class="mt-3 pt-3 border-t border-green-200 dark:border-green-800 text-xs">
            <summary class="cursor-pointer text-green-900 dark:text-green-200 font-medium">Wrong purchase?</summary>
            <form method="POST" action="/paperless/ocr/<%= doc.paperlessId %>/unlink" class="mt-2 flex flex-wrap items-center gap-2" data-unlink-form>
              <input type="hidden" name="_csrf" value="<%= _csrf %>">
              <label class="inline-flex items-center gap-1.5 text-green-900 dark:text-green-200">
                <input type="checkbox" name="confirm" value="yes" required>
                This document isn't purchase #<%= doc.kashflowPurchaseNumber || doc.kashflowPurchaseId %>
              </label>
              <button type="submit" class="px-2.5 py-1 rounded-lg border border-red-300 dark:border-red-700 bg-white dark:bg-gray-900 text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 font-medium">Unlink from KashFlow</button>
              <span class="text-green-800 dark:text-green-300 w-full">Removes the link here and in Paperless. Nothing is deleted in KashFlow. It goes back to Needs Data Entry, or to Ready for KashFlow if it was entered.</span>
            </form>
          </details>
          <% } %>
        <% } else { %>
          <p class="text-sm text-gray-700 dark:text-gray-300">Not linked to a KashFlow purchase.</p>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            <% if (doc.processingState === 'awaiting_entry') { %>Enter it on the data entry screen, then send it from the draft.
            <% } else if (doc.processingState === 'entered') { %>It's entered. Send it from the draft, or match it if it's already in KashFlow.
            <% } else { %>If it's already in KashFlow, use Match Purchase to link it.<% } %>
          </p>
        <% } %>
      </section>

      <section class="<%= _card %> p-4">
        <h2 class="<%= _h2 %> mb-3">Document</h2>
        <dl class="text-sm space-y-2.5">
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Paperless ID</dt><dd class="font-mono text-xs self-center">#<%= doc.paperlessId %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400 shrink-0">Correspondent</dt><dd class="text-right break-words"><%= doc.correspondent?.name || '—' %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Created</dt><dd class="text-right" data-created><%= _fmt(doc.created) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Modified</dt><dd class="text-right"><%= _fmt(doc.modified) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">File</dt><dd class="text-right break-all font-mono text-xs self-center"><%= doc.originalFileName || doc.archivedFileName || '—' %></dd></div>
        </dl>
        <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700 text-sm">
          <%- include('../partials/_documentType', { doc, documentTypes: locals.documentTypes, back: 'details' }) %>
        </div>
        <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700">
          <div class="text-sm text-gray-500 dark:text-gray-400 mb-1.5">Tags</div>
          <% if ((doc.tags || []).length) { %>
            <div class="flex flex-wrap gap-1.5">
              <% doc.tags.forEach(t => { %><span class="<%= _pill %> font-normal <%= _tone.slate %>"><%= t.name %></span><% }) %>
            </div>
          <% } else { %><span class="text-sm text-gray-400 dark:text-gray-500">None</span><% } %>
        </div>
      </section>

      <section class="<%= _card %> p-4">
        <h2 class="<%= _h2 %> mb-3">Ingest</h2>
        <% if (ingest) { %>
          <dl class="text-sm space-y-2.5">
            <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Status</dt>
              <dd><span class="<%= _pill %> <%= ingest.status === 'error' ? _tone.red : ingest.status === 'fetched' ? _tone.green : _tone.slate %>"><%= ingest.status %></span></dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Last modified</dt><dd class="text-right"><%= _fmt(ingest.lastModified) %></dd></div>
            <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Last fetched</dt><dd class="text-right"><%= _fmt(ingest.lastFetchedAt) %></dd></div>
            <div><dt class="text-gray-500 dark:text-gray-400">Content hash</dt><dd class="mt-0.5 font-mono text-xs break-all text-gray-700 dark:text-gray-300"><%= ingest.lastContentHash || '—' %></dd></div>
          </dl>
          <% if (ingest.error) { %>
            <div class="mt-3 p-2.5 rounded-lg border border-red-300 dark:border-red-700 bg-red-50 dark:bg-red-900/20 text-xs text-red-800 dark:text-red-300 break-words">Error: <%= ingest.error %></div>
          <% } %>
        <% } else { %>
          <div class="text-sm text-gray-400 dark:text-gray-500">No ingest record yet.</div>
        <% } %>
      </section>
    </aside>
  </div>
</div>
